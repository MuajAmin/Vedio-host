# Environment
NODE_ENV=production

# Node.js memory limit (MB) — adjust for your VPS RAM
NODE_OPTIONS=--max-old-space-size=384

# User passwords (CHANGE THESE — use strong passwords!)
MUAJ_PASSWORD=change_this_to_a_strong_password
HAJERA_PASSWORD=change_this_to_a_strong_password

# Session secret key (MUST be a long random string in production)
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change_this_to_a_random_64_char_string

# Server port
PORT=3000

# Max file size in MB
MAX_FILE_SIZE_MB=500

# Set to 'true' if behind HTTPS (nginx with SSL)
COOKIE_SECURE=false

# Web Push VAPID Keys (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@yoursite.com

# yt-dlp cookie settings (fixes Pornhub HTTP 410 error)
# Option 1 — VPS: Export cookies.txt from your PC browser, upload to server
YTDLP_COOKIES_FILE=./data/cookies.txt
# Option 2 — Local dev only: auto-extract from installed browser
# YTDLP_COOKIES_BROWSER=chrome

# Cloudflare R2 CDN — offloads video streaming bandwidth to Cloudflare edge
# Get these from: Cloudflare Dashboard → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=videohost
R2_PUBLIC_URL=

# Cloudflare Workers — Edge cache purge on video deletion
# Required only if using the VideoHost Edge Worker (workers/ directory)
# Get Zone ID from: Cloudflare Dashboard → Your domain → Overview (right sidebar)
# Create API Token at: Cloudflare Dashboard → My Profile → API Tokens → Create Token
#   Use template: "Edit zone" or custom with Zone.Cache Purge permission
CF_ZONE_ID=
CF_API_TOKEN=
CF_DOMAIN=muaj.bro.bd

# Watch Together — Durable Objects (Cloudflare Workers Paid plan required)
# Set USE_DURABLE_OBJECTS=true to route Watch Together through Cloudflare edge.
# Set to false (or omit) to keep using the VPS in-memory SSE implementation.
USE_DURABLE_OBJECTS=false
# Shared HMAC-SHA256 secret for auth tokens between VPS and Worker.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must also be set as a Worker secret: wrangler secret put WT_SHARED_SECRET
WT_SHARED_SECRET=
