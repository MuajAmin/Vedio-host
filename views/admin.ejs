<%
const h = escapeHtml;
const currentUnread = (typeof unreadCount !== 'undefined' && unreadCount > 0) ? unreadCount : 0;
const unreadDisplay = currentUnread > 0 ? (currentUnread > 99 ? '99+' : currentUnread) : '0';
const unreadStyle = currentUnread > 0 ? 'display:flex;' : 'display:none;';
const avatars = (typeof userAvatars !== 'undefined' && userAvatars) ? userAvatars : ((typeof locals !== 'undefined' && locals.userAvatars) ? locals.userAvatars : {});
function renderAvatar(uname, extraCls = '') {
    const avatar = avatars[uname];
    const cleanCls = h(extraCls || '');
    const cleanUname = h(uname || '');
    if (avatar) {
        return `<img src="/avatars/${h(avatar)}" alt="${cleanUname}" class="avatar-img ${cleanCls}" loading="lazy" />`;
    }
    const letter = (uname === 'muaj') ? 'M' : 'H';
    const roleClass = (uname === 'muaj') ? 'avatar-admin' : 'avatar-viewer';
    return `<div class="avatar-letter ${roleClass} ${cleanCls}">${letter}</div>`;
}

function formatBytes(value) {
    const bytes = Number(value || 0);
    if (!Number.isFinite(bytes) || bytes <= 0) return '0 MB';
    if (bytes >= 1024 * 1024 * 1024) return (bytes / (1024 * 1024 * 1024)).toFixed(2) + ' GB';
    return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
}

function parseSqliteDate(str) {
    if (!str) return 0;
    if (typeof str === 'number') return str;
    const s = String(str);
    const iso = s.includes('T') ? (s.endsWith('Z') ? s : s + 'Z') : s.replace(' ', 'T') + 'Z';
    const t = new Date(iso).getTime();
    return isNaN(t) ? new Date(str).getTime() : t;
}

function formatDate(value) {
    if (!value) return '-';
    const t = parseSqliteDate(value);
    return new Date(t).toLocaleString('bn-BD', {
        day: 'numeric',
        month: 'short',
        hour: '2-digit',
        minute: '2-digit'
    });
}

function formatSeconds(sec) {
    const s = Number(sec || 0);
    if (!s || isNaN(s)) return '0:00';
    const hrs = Math.floor(s / 3600);
    const mins = Math.floor((s % 3600) / 60);
    const secs = Math.floor(s % 60);
    if (hrs > 0) {
        return hrs + ':' + (mins < 10 ? '0' : '') + mins + ':' + (secs < 10 ? '0' : '') + secs;
    }
    return mins + ':' + (secs < 10 ? '0' : '') + secs;
}

function timeAgo(dateString) {
    if (!dateString) return '-';
    const timestamp = parseSqliteDate(dateString);
    const now = Date.now();
    const seconds = Math.floor((now - timestamp) / 1000);
    if (isNaN(seconds) || seconds < 0) return '-';
    if (seconds < 60) return 'Just now';
    const minutes = Math.floor(seconds / 60);
    if (minutes < 60) return minutes + 'm ago';
    const hours = Math.floor(minutes / 60);
    if (hours < 24) return hours + 'h ago';
    const days = Math.floor(hours / 24);
    if (days === 1) return 'Yesterday';
    if (days < 7) return days + 'd ago';
    const weeks = Math.floor(days / 7);
    if (weeks < 4) return weeks + 'w ago';
    const months = Math.floor(days / 30);
    if (months < 12) return months + 'mo ago';
    const years = Math.floor(days / 365);
    return years + 'y ago';
}

const importJobs = (stats && Array.isArray(stats.importJobs)) ? stats.importJobs : [];
const videoList = (stats && Array.isArray(stats.videos)) ? stats.videos : [];
