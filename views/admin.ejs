<%
const h = escapeHtml;
const avatars = (typeof userAvatars !== 'undefined' && userAvatars) ? userAvatars : ((typeof locals !== 'undefined' && locals.userAvatars) ? locals.userAvatars : {});
function renderAvatar(uname, extraCls = '') {
    const avatar = avatars[uname];
    const cleanCls = h(extraCls || '');
    const cleanUname = h(uname || '');
    if (avatar) {
        return `<img src="/avatars/${h(avatar)}" alt="${cleanUname}" class="avatar-img ${cleanCls}" loading="lazy" />`;
    }
    const letter = (uname === 'muaj') ? 'M' : 'H';
    const roleClass = (uname === 'muaj') ? 'avatar-admin' : 'avatar-viewer';
    return `<div class="avatar-letter ${roleClass} ${cleanCls}">${letter}</div>`;
}

function formatBytes(value) {
    const bytes = Number(value || 0);
    if (!Number.isFinite(bytes) || bytes <= 0) return '0 MB';
    if (bytes >= 1024 * 1024 * 1024) return (bytes / (1024 * 1024 * 1024)).toFixed(2) + ' GB';
    return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
}

function formatDate(value) {
    if (!value) return '-';
    return new Date(value).toLocaleString('bn-BD', {
        day: 'numeric',
        month: 'short',
        hour: '2-digit',
        minute: '2-digit'
    });
}

function formatSeconds(sec) {
    const s = Number(sec || 0);
    if (!s || isNaN(s)) return '0:00';
    const hrs = Math.floor(s / 3600);
    const mins = Math.floor((s % 3600) / 60);
    const secs = Math.floor(s % 60);
    if (hrs > 0) {
        return hrs + ':' + (mins < 10 ? '0' : '') + mins + ':' + (secs < 10 ? '0' : '') + secs;
    }
    return mins + ':' + (secs < 10 ? '0' : '') + secs;
}

function timeAgo(dateString) {
    if (!dateString) return '-';
    const date = new Date(dateString);
    const now = new Date();
    const seconds = Math.floor((now - date) / 1000);
    if (isNaN(seconds) || seconds < 0) return '-';
    if (seconds < 60) return 'Just now';
    const minutes = Math.floor(seconds / 60);
    if (minutes < 60) return minutes + 'm ago';
    const hours = Math.floor(minutes / 60);
    if (hours < 24) return hours + 'h ago';
    const days = Math.floor(hours / 24);
    if (days === 1) return 'Yesterday';
    if (days < 7) return days + 'd ago';
    const weeks = Math.floor(days / 7);
    if (weeks < 4) return weeks + 'w ago';
    const months = Math.floor(days / 30);
    if (months < 12) return months + 'mo ago';
    const years = Math.floor(days / 365);
    return years + 'y ago';
}

const importJobs = (stats && Array.isArray(stats.importJobs)) ? stats.importJobs : [];
const videoList = (stats && Array.isArray(stats.videos)) ? stats.videos : [];
const activeJobs = importJobs.filter(job => ['queued', 'starting', 'downloading'].includes(job.status));
const failedJobs = importJobs.filter(job => ['error', 'canceled'].includes(job.status)).slice(0, 8);
const recentVideos = videoList.slice(0, 10);
const hajeraStats = (stats && stats.hajeraStats) ? stats.hajeraStats : { totalWatched: 0, completedCount: 0, inProgressCount: 0, openedCount: 0, recentActivity: [] };
const hajeraActivityList = hajeraStats.recentActivity || [];

const cleanupHtml = (typeof cleanupResult !== 'undefined' && cleanupResult)
    ? `<div class="alert admin-alert"><span>${h(cleanupResult.deleted)} files deleted, ${h(formatBytes(cleanupResult.bytesFreed))} freed.</span></div>`
    : '';

const hajeraCardsHtml = hajeraActivityList.length === 0
    ? `<div class="hajera-empty-card">
        <div class="hajera-empty-icon-wrap">
            <div class="hajera-empty-icon">💖</div>
        </div>
        <h3 class="hajera-empty-title">No Watch Activity Yet</h3>
        <p class="hajera-empty-desc">Hajera hasn't watched any videos from her account yet. When she logs in and watches videos, her real-time progress, time spent, and watched videos will appear right here!</p>
        <div class="hajera-empty-pill">
            <span class="pill-dot"></span>
            <span><strong>${videoList.length}</strong> videos in library waiting for Hajera</span>
        </div>
       </div>`
    : hajeraActivityList.map(item => {
        const pos = Number(item.position_seconds || 0);
        const dur = Number(item.duration_seconds || 0);
        const percent = dur > 0 ? Math.min(100, Math.round((pos / dur) * 100)) : (pos > 0 ? 100 : 0);
        const isCompleted = dur > 0 && pos >= dur - 15;
        const isInProgress = pos >= 10 && !isCompleted;
        
        let statusBadge = '';
        if (isCompleted) {
            statusBadge = '<span class="activity-badge badge-completed"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="11" height="11"><polyline points="20 6 9 17 4 12"/></svg> Completed</span>';
        } else if (isInProgress) {
            statusBadge = `<span class="activity-badge badge-progress"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="11" height="11"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg> Watching (${percent}%)</span>`;
        } else {
            statusBadge = '<span class="activity-badge badge-opened"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="11" height="11"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg> Opened</span>';
        }

        const thumbImg = item.thumbnail
            ? `<img src="/thumbnails/${h(item.thumbnail)}" alt="${h(item.title)}" class="hajera-card-thumb-img" loading="lazy" />`
            : '<div class="hajera-card-thumb-placeholder"><svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20"><polygon points="6,4 20,12 6,20"/></svg></div>';

        return `<a href="/watch/${encodeURIComponent(item.video_id)}" class="hajera-mobile-card">
            <div class="hajera-mobile-card-thumb">
                ${thumbImg}
                <span class="hajera-thumb-duration">${h(item.formatted_duration || formatSeconds(dur))}</span>
            </div>
            <div class="hajera-mobile-card-details">
                <h4 class="hajera-mobile-card-title">${h(item.title)}</h4>
                <div class="hajera-mobile-card-meta">
                    ${statusBadge}
                    <span class="hajera-mobile-card-time">${h(timeAgo(item.updated_at))}</span>
                </div>
                <div class="hajera-mobile-progress-wrap">
                    <div class="activity-progress-bar">
                        <div class="activity-progress-fill ${isCompleted ? 'is-complete' : ''}" style="width: ${percent}%;"></div>
                    </div>
                    <span class="hajera-mobile-time-spent">${h(formatSeconds(pos))} / ${h(item.formatted_duration || formatSeconds(dur))}</span>
                </div>
            </div>
        </a>`;
    }).join('');

const hajeraRows = hajeraActivityList.length === 0
    ? '<tr><td colspan="6" class="admin-empty-table">No watch activity recorded for Hajera yet.</td></tr>'
    : hajeraActivityList.map(item => {
        const pos = Number(item.position_seconds || 0);
        const dur = Number(item.duration_seconds || 0);
        const percent = dur > 0 ? Math.min(100, Math.round((pos / dur) * 100)) : (pos > 0 ? 100 : 0);
        const isCompleted = dur > 0 && pos >= dur - 15;
        const isInProgress = pos >= 10 && !isCompleted;
        
        let statusBadge = '';
        if (isCompleted) {
            statusBadge = '<span class="activity-badge badge-completed"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="12" height="12"><polyline points="20 6 9 17 4 12"/></svg> Completed</span>';
        } else if (isInProgress) {
            statusBadge = `<span class="activity-badge badge-progress"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="12" height="12"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg> Watching (${percent}%)</span>`;
        } else {
            statusBadge = '<span class="activity-badge badge-opened"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="12" height="12"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg> Opened</span>';
        }

        const thumbHtml = item.thumbnail
            ? `<img src="/thumbnails/${h(item.thumbnail)}" alt="${h(item.title)}" class="admin-table-thumb-img" loading="lazy" />`
            : '<div class="admin-table-thumb-placeholder"><svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><polygon points="6,4 20,12 6,20"/></svg></div>';

        return `
        <tr>
            <td class="cell-video-thumb">
                <a href="/watch/${encodeURIComponent(item.video_id)}" class="admin-table-thumb-link">
                    ${thumbHtml}
                </a>
            </td>
            <td class="cell-video-title">
                <a href="/watch/${encodeURIComponent(item.video_id)}" class="admin-video-link">
                    <strong>${h(item.title)}</strong>
                </a>
            </td>
            <td class="cell-progress">
                <div class="activity-progress-wrap">
                    <div class="activity-progress-bar">
                        <div class="activity-progress-fill ${isCompleted ? 'is-complete' : ''}" style="width: ${percent}%;"></div>
                    </div>
                    <span class="activity-progress-text">${percent}%</span>
                </div>
            </td>
            <td class="cell-duration">
                <span class="activity-time-text">${h(formatSeconds(pos))} / ${h(item.formatted_duration || formatSeconds(dur))}</span>
            </td>
            <td class="cell-status">
                ${statusBadge}
            </td>
            <td class="cell-last-watched">
                <span class="activity-relative-time" title="${h(formatDate(item.updated_at))}">${h(timeAgo(item.updated_at))}</span>
            </td>
        </tr>
    `;}).join('');

const jobRows = activeJobs.length === 0
    ? '<div class="admin-empty">No active import jobs.</div>'
    : activeJobs.map(job => `
        <div class="admin-job-row">
            <div>
                <strong>${h(job.title || 'Import job')}</strong>
                <span>${h(job.status)}${job.queuePosition ? ' - queue #' + h(job.queuePosition) : ''}</span>
            </div>
            <div class="admin-job-progress">
                <div class="admin-mini-bar"><span style="width:${h(job.progress || 0)}%"></span></div>
                <em>${h(job.progress || 0)}%</em>
            </div>
        </div>
    `).join('');

const failedRows = failedJobs.length === 0
    ? '<div class="admin-empty">No failed imports in memory.</div>'
    : failedJobs.map(job => `
        <div class="admin-job-row failed">
            <div>
                <strong>${h(job.title || job.url || 'Import job')}</strong>
                <span>${h(job.error || job.status)}</span>
            </div>
            <em>${h(formatDate(job.finishedAt || job.createdAt))}</em>
        </div>
    `).join('');

const videoCardsHtml = recentVideos.length === 0
    ? '<div class="admin-empty">No videos uploaded yet.</div>'
    : recentVideos.map(video => {
        const uploader = video.uploaded_by || 'muaj';
        const uploaderName = uploader === 'hajera' ? 'Hajera' : (uploader === 'muaj' ? 'Muaj' : uploader);
        const thumbHtml = video.thumbnail
            ? `<img src="/thumbnails/${h(video.thumbnail)}" alt="${h(video.title)}" class="admin-video-card-thumb-img" loading="lazy" />`
            : '<div class="admin-video-card-thumb-placeholder"><svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20"><polygon points="6,4 20,12 6,20"/></svg></div>';
        return `
        <a href="/watch/${encodeURIComponent(video.id)}" class="admin-video-mobile-card">
            <div class="admin-video-card-thumb">
                ${thumbHtml}
                <span class="admin-video-card-dur">${h(video.duration || '-')}</span>
            </div>
            <div class="admin-video-card-info">
                <h4 class="admin-video-card-title">${h(video.title)}</h4>
                <div class="admin-video-card-meta">
                    <div class="admin-user-cell"><div class="badge-avatar">${renderAvatar(uploader, 'admin-row-avatar')}</div><span>${h(uploaderName)}</span></div>
                    <span class="admin-video-pill">${h(formatBytes(video.size))}</span>
                    <span class="admin-video-pill quality-pill">${h(video.import_quality || 'HD')}</span>
                    <span class="admin-video-time">${h(timeAgo(video.uploaded_at))}</span>
                </div>
            </div>
        </a>
    `;}).join('');

const videoRows = recentVideos.length === 0
    ? '<tr><td colspan="6">No videos yet.</td></tr>'
    : recentVideos.map(video => {
        const uploader = video.uploaded_by || 'muaj';
        const uploaderName = uploader === 'hajera' ? 'Hajera' : (uploader === 'muaj' ? 'Muaj' : uploader);
        return `
        <tr>
            <td><a href="/watch/${encodeURIComponent(video.id)}">${h(video.title)}</a></td>
            <td><div class="admin-user-cell"><div class="badge-avatar">${renderAvatar(uploader, 'admin-row-avatar')}</div><span>${h(uploaderName)}</span></div></td>
            <td>${h(formatBytes(video.size))}</td>
            <td>${h(video.duration || '-')}</td>
            <td>${h(video.import_quality || 'Upload')}</td>
            <td>${h(formatDate(video.uploaded_at))}</td>
        </tr>
    `;}).join('');
%>
<%- include('layout', { pageTitle: 'Admin', body: `
