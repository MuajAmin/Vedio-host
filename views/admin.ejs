                    <span>Used: <strong id="vpsRamUsed">${h(sys.ram.usedFormatted)}</strong></span>
                    <span>Process RSS: <strong id="vpsNodeRss">${h(sys.process.rssMb)} MB</strong></span>
                </div>
            </div>

            <!-- 3. Disk Storage Card -->
            <div class="vps-metric-box metric-disk ${diskHealthCls}">
                <div class="metric-top-row">
                    <div class="metric-icon-title">
                        <div class="metric-badge-icon badge-disk">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                                <ellipse cx="12" cy="5" rx="9" ry="3"/>
                                <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/>
                                <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/>
                            </svg>
                        </div>
                        <div>
                            <span class="metric-name">VPS Disk Drive</span>
                            <span class="metric-sub" id="vpsDiskFree">${h(sys.disk.freeFormatted)} Free of ${h(sys.disk.totalFormatted)}</span>
                        </div>
                    </div>
                    <div class="metric-val-wrap">
                        <span class="metric-pct" id="vpsDiskPct">${h(diskPct)}%</span>
                    </div>
                </div>
                <div class="metric-bar-track">
                    <div class="metric-bar-fill fill-disk" id="vpsDiskBar" style="width: ${h(diskPct)}%;"></div>
                </div>
                <div class="metric-bottom-info">
                    <span>Used: <strong id="vpsDiskUsed">${h(sys.disk.usedFormatted)}</strong></span>
                    <span>Videos: <strong>${h(formatBytes(stats.storageBytes || 0))}</strong></span>
                </div>
            </div>

            <!-- 4. Internet & VPS Bandwidth Usage Card -->
            <div class="vps-metric-box metric-network">
                <div class="metric-top-row">
                    <div class="metric-icon-title">
                        <div class="metric-badge-icon badge-network">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                                <circle cx="12" cy="12" r="10"/>
                                <line x1="2" y1="12" x2="22" y2="12"/>
                                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                            </svg>
                        </div>
                        <div>
                            <span class="metric-name">Internet Traffic</span>
                            <span class="metric-sub" id="vpsNetQuota">Quota: 1,000 GB (1 TB)</span>
                        </div>
                    </div>
                    <div class="metric-val-wrap">
                        <span class="metric-pct" id="vpsNetTotal">${h(sys.network ? sys.network.totalFormatted : '0 GB')}</span>
                    </div>
                </div>
                <div class="metric-bar-track">
                    <div class="metric-bar-fill fill-network" id="vpsNetBar" style="width: ${h(sys.network ? Math.max(2, sys.network.usagePercent) : 2)}%;"></div>
                </div>
                <div class="metric-bottom-info">
                    <span>📤 Sent: <strong id="vpsNetTx">${h(sys.network ? sys.network.txFormatted : '0 GB')}</strong></span>
                    <span>📥 Recv: <strong id="vpsNetRx">${h(sys.network ? sys.network.rxFormatted : '0 GB')}</strong></span>
                </div>
            </div>

            <!-- 5. Node.js & Runtime Card -->
            <div class="vps-metric-box metric-node">
                <div class="metric-top-row">
                    <div class="metric-icon-title">
                        <div class="metric-badge-icon badge-node">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                                <polygon points="12 2 2 7 12 12 22 7 12 2"/>
                                <polyline points="2 17 12 22 22 17"/>
                                <polyline points="2 12 12 17 22 12"/>
                            </svg>
                        </div>
                        <div>
                            <span class="metric-name">Node.js Runtime</span>
                            <span class="metric-sub">Version <strong id="vpsNodeVer">${h(sys.process.nodeVersion)}</strong></span>
                        </div>
                    </div>
                    <div class="metric-val-wrap">
                        <span class="metric-badge-pill" id="vpsAppUptime">App Up: ${h(sys.process.uptimeFormatted)}</span>
                    </div>
                </div>
                <div class="metric-runtime-details">
                    <div class="runtime-chip">
                        <span class="chip-k">Heap Used</span>
                        <strong class="chip-v" id="vpsHeapUsed">${h(sys.process.heapUsedMb)} MB</strong>
                    </div>
                    <div class="runtime-chip">
                        <span class="chip-k">Heap Total</span>
                        <strong class="chip-v" id="vpsHeapTotal">${h(sys.process.heapTotalMb)} MB</strong>
                    </div>
                    <div class="runtime-chip">
                        <span class="chip-k">DB Sessions</span>
                        <strong class="chip-v">${h(stats.sessionCount || 0)}</strong>
                    </div>
                </div>
            </div>
        </div>
    </section>`;
}

