                    </thead>
                    <tbody>${videoRows}</tbody>
                </table>
            </div>
            <!-- Mobile Android Video Cards -->
            <div class="admin-mobile-video-cards">
                ${videoCardsHtml}
            </div>
        </section>
    </main>

    <nav class="mobile-bottom-bar">
