                    </svg>
                </div>
                <div class="stat-text-group">
                    <span>Orphan Files</span>
                    <strong>${h((stats.orphanVideos ? stats.orphanVideos.length : 0) + (stats.orphanThumbnails ? stats.orphanThumbnails.length : 0))}</strong>
                </div>
            </div>
        </section>

        <section class="admin-grid">
            <div class="admin-panel">
                <div class="admin-panel-header">
                    <h2>Import Queue</h2>
                    <span>${h(activeJobs.length)} active</span>
                </div>
                ${jobRows}
            </div>

            <div class="admin-panel">
                <div class="admin-panel-header">
