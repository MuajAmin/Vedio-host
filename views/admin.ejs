                <div class="hajera-card-meta-row">
                    ${statusBadge}
                    <span class="hajera-card-time-info">${h(timeSpentText)}</span>
                </div>
                <div class="hajera-card-progress-track">
                    <div class="hajera-card-progress-fill ${isCompleted ? 'fill-completed' : (isInProgress ? 'fill-watching' : '')}" style="width: ${percent}%;"></div>
