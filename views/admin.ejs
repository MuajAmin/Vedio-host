                    <path d="M21 12c0 4.42-4.03 8-9 8-1.5 0-2.91-.36-4.15-1.01L3 21l2.01-4.84A7.9 7.9 0 0 1 3 12c0-4.42 4.03-8 9-8s9 3.58 9 8z"/>
