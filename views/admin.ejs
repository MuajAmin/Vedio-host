        <a href="/watch/${encodeURIComponent(video.id)}" class="admin-video-android-card">
            <div class="admin-video-thumb-wrap">
                ${thumbHtml}
                <span class="admin-video-dur-pill">${h(video.duration || '-')}</span>
            </div>
            <div class="admin-video-body">
                <h4 class="admin-video-title">${h(video.title)}</h4>
                <div class="admin-video-meta-tags">
                    <div class="admin-user-cell">
                        <div class="badge-avatar">${renderAvatar(uploader, 'admin-row-avatar')}</div>
                        <span>${h(uploaderName)}</span>
                    </div>
                    <span class="admin-video-tag">${h(formatBytes(video.size))}</span>
                    <span class="admin-video-tag quality-tag">${h(video.import_quality || 'HD')}</span>
                    <span class="admin-video-time-tag">${h(timeAgo(video.uploaded_at))}</span>
                </div>
            </div>
        </a>
    `;}).join('');

const videoRows = recentVideos.length === 0
    ? '<tr><td colspan="7" class="admin-empty-table">No videos in library yet.</td></tr>'
    : recentVideos.map(video => {
        const uploader = video.uploaded_by || 'muaj';
        const uploaderName = uploader === 'hajera' ? 'Hajera' : (uploader === 'muaj' ? 'Muaj' : uploader);
        return `
        <tr>
            <td><a href="/watch/${encodeURIComponent(video.id)}" class="admin-table-video-title"><strong>${h(video.title)}</strong></a></td>
            <td><div class="admin-user-cell"><div class="badge-avatar">${renderAvatar(uploader, 'admin-row-avatar')}</div><span>${h(uploaderName)}</span></div></td>
            <td><span class="admin-table-pill">${h(formatBytes(video.size))}</span></td>
            <td><span class="admin-table-dur">${h(video.duration || '-')}</span></td>
            <td><span class="admin-table-quality">${h(video.import_quality || 'Upload')}</span></td>
            <td><span class="activity-relative-time" title="${h(formatDate(video.uploaded_at))}">${h(timeAgo(video.uploaded_at))}</span></td>
            <td>
                <form action="/delete/${encodeURIComponent(video.id)}" method="POST" data-confirm="Delete '${h(video.title)}'? This cannot be undone." style="margin: 0;">
                    <input type="hidden" name="_csrf" value="${h(csrfToken)}">
                    <button type="submit" class="btn btn-danger btn-xs" title="Delete video" style="padding: 4px 8px; font-size: 0.75rem; border-radius: 4px; display: inline-flex; align-items: center; gap: 4px;">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="12" height="12">
                            <polyline points="3 6 5 6 21 6"/>
                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                        </svg>
                        <span>Delete</span>
                    </button>
                </form>
            </td>
        </tr>
    `;}).join('');
%>
<%- include('layout', { pageTitle: 'Admin Control Center', body: `
<div class="app-container admin-app-container">
    <div class="ambient-background">
        <div class="ambient-orb orb-1"></div>
        <div class="ambient-orb orb-2"></div>
    </div>

    <!-- Android Native App Bar -->
    <header class="android-app-bar" id="mainNavbar">
        <div class="app-bar-left">
            <a href="/dashboard" class="app-bar-back-btn" title="Back to Library">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="20" height="20">
                    <line x1="19" y1="12" x2="5" y2="12"/>
                    <polyline points="12 19 5 12 12 5"/>
                </svg>
            </a>
            <div class="app-bar-title-wrap">
                <span class="app-bar-badge">Admin Panel</span>
                <h1 class="app-bar-title">Control Center</h1>
            </div>
        </div>
        <div class="app-bar-actions">
            <a href="/messages" class="btn btn-ghost nav-msg-btn" title="Direct Messages">
                <div class="nav-btn-icon-wrap">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                        <path d="M21 12c0 4.42-4.03 8-9 8-1.5 0-2.91-.36-4.15-1.01L3 21l2.01-4.84A7.9 7.9 0 0 1 3 12c0-4.42 4.03-8 9-8s9 3.58 9 8z" stroke-linecap="round" stroke-linejoin="round"/>
                        <circle cx="8.5" cy="11.5" r="1" fill="currentColor"/>
                        <circle cx="12" cy="11.5" r="1" fill="currentColor"/>
                        <circle cx="15.5" cy="11.5" r="1" fill="currentColor"/>
                    </svg>
                    <span class="nav-msg-badge" style="${unreadStyle}">${unreadDisplay}</span>
                </div>
                <span class="nav-btn-text">Chat</span>
            </a>
            <button type="button" class="btn-app-bar-action" id="themeSwitcherNavBtn" title="Palette Themes">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                    <circle cx="12" cy="12" r="10"/>
                    <path d="M12 2a10 10 0 0 0 0 20z" fill="currentColor" opacity="0.4"/>
                </svg>
            </button>
            <div class="user-badge badge-admin user-profile-trigger" id="profileBadgeBtn" role="button" tabindex="0" title="Change Avatar">
                <div class="badge-avatar-wrap">
                    <div class="badge-avatar">${renderAvatar(user, 'nav-avatar')}</div>
                    <span class="badge-status-dot"></span>
                </div>
                <div class="badge-info">
                    <span class="user-name">Muaj</span>
                    <span class="badge-role">Admin</span>
                </div>
                <svg class="badge-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="12" height="12">
                    <polyline points="6 9 12 15 18 9"/>
                </svg>
            </div>
            <form action="/logout" method="POST" class="nav-form desktop-only-logout">
                <input type="hidden" name="_csrf" value="${h(csrfToken)}">
                <button type="submit" class="btn btn-ghost btn-nav-logout" title="Logout">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                        <polyline points="16 17 21 12 16 7"/>
                        <line x1="21" y1="12" x2="9" y2="12"/>
                    </svg>
                    <span class="nav-btn-text">Logout</span>
                </button>
            </form>
        </div>
    </header>

    <main class="main-content admin-main-content">
        <!-- Status & Cleanup Toolbar Banner -->
        <div class="admin-quick-toolbar">
            <div class="quick-toolbar-info">
                <span class="live-dot-indicator"></span>
                <span><strong>${h(videoList.length)}</strong> Videos stored • <strong>${h(formatBytes(stats.storageBytes || 0))}</strong> Total</span>
            </div>
            <form action="/admin/cleanup" method="POST" data-confirm="Clean up orphan upload files that are not referenced in the database?">
                <input type="hidden" name="_csrf" value="${h(csrfToken)}">
                <button type="submit" class="btn-cleanup-compact" title="Remove unreferenced files">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15">
                        <path d="M3 6h18"/>
                        <path d="M8 6V4h8v2"/>
                        <path d="M19 6l-1 14H6L5 6"/>
                    </svg>
                    <span>Cleanup</span>
                </button>
            </form>
        </div>

        ${cleanupHtml}
        ${accessMsgHtml}
        ${vpsMonitorHtml}
        ${r2HubHtml}

        <!-- 6-Tile Android Stat Grid -->
        <section class="admin-stat-tiles-grid">
            <div class="stat-tile tile-videos">
                <div class="stat-tile-icon icon-cyan">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
                        <polygon points="23 7 16 12 23 17 23 7"/>
                        <rect x="1" y="5" width="15" height="14" rx="2" ry="2"/>
                    </svg>
                </div>
                <div class="stat-tile-info">
                    <span class="stat-tile-label">Videos</span>
                    <strong class="stat-tile-val">${h(videoList.length)}</strong>
                </div>
            </div>

            <div class="stat-tile tile-storage">
                <div class="stat-tile-icon icon-amber">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
                        <ellipse cx="12" cy="5" rx="9" ry="3"/>
                        <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/>
                        <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/>
                    </svg>
                </div>
                <div class="stat-tile-info">
                    <span class="stat-tile-label">Storage</span>
                    <strong class="stat-tile-val">${h(formatBytes(stats.storageBytes || 0))}</strong>
                </div>
            </div>

            <div class="stat-tile tile-comments">
                <div class="stat-tile-icon icon-emerald">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                    </svg>
                </div>
                <div class="stat-tile-info">
                    <span class="stat-tile-label">Comments</span>
                    <strong class="stat-tile-val">${h(stats.commentsCount || 0)}</strong>
                </div>
            </div>

            <div class="stat-tile tile-sessions">
                <div class="stat-tile-icon icon-violet">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                        <circle cx="9" cy="7" r="4"/>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                    </svg>
                </div>
                <div class="stat-tile-info">
                    <span class="stat-tile-label">Sessions</span>
                    <strong class="stat-tile-val">${h(stats.sessionCount || 0)}</strong>
                </div>
            </div>

            <div class="stat-tile tile-progress">
                <div class="stat-tile-icon icon-rose">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
                        <circle cx="12" cy="12" r="10"/>
                        <polyline points="12 6 12 12 16 14"/>
                    </svg>
                </div>
                <div class="stat-tile-info">
                    <span class="stat-tile-label">Watch Events</span>
                    <strong class="stat-tile-val">${h(stats.progressCount || 0)}</strong>
                </div>
            </div>

            <div class="stat-tile tile-orphans">
                <div class="stat-tile-icon icon-coral">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
                        <path d="M3 6h18"/>
                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                    </svg>
                </div>
                <div class="stat-tile-info">
                    <span class="stat-tile-label">Orphan Files</span>
                    <strong class="stat-tile-val">${h((stats.orphanVideos ? stats.orphanVideos.length : 0) + (stats.orphanThumbnails ? stats.orphanThumbnails.length : 0))}</strong>
                </div>
            </div>
        </section>

        <!-- HAJERA'S WATCH ACTIVITY SHOWCASE SECTION -->
        <section class="admin-section-card hajera-tracker-section">
            <!-- Hajera Hero Engagement Banner -->
            <div class="hajera-hero-widget">
                <div class="hajera-hero-bg-glow"></div>
                <div class="hajera-hero-main">
                    <div class="hajera-hero-avatar-wrap">
                        <div class="hajera-hero-avatar">
                            ${renderAvatar('hajera', 'hajera-avatar-hero')}
                        </div>
                        <div class="hajera-hero-online-dot ${presenceDotClass}" id="hajeraHeroOnlineDot" title="${h(presence.status)}"></div>
                    </div>
                    <div class="hajera-hero-info">
                        <div class="hajera-hero-tag">
                            <span class="heart-pulse">💖</span>
                            <span class="tag-title">Hajera's Watch Tracker</span>
                            ${presenceBadge}
                            <span class="hero-last-active" id="hajeraLastActiveText" title="Last Active Timestamp">⏱️ ${h(lastActiveText)}</span>
                            <span class="live-sync-indicator" title="Live Auto-Sync Active"><span class="sync-dot"></span> Live 4s</span>
                        </div>
                        <h2 class="hajera-hero-title">Viewing Habits & Live Presence</h2>
                        <p class="hajera-hero-desc" id="hajeraHeroDesc">${h(watchedCount)} of ${h(totalVideos)} library videos explored (${h(overallPercent)}%) ${presence.deviceInfo ? '• ' + h(presence.deviceInfo) : ''}</p>
                    </div>
                </div>

                <!-- Live Playing Card (Active video playback) -->
                ${liveVideoPlayingHtml}

                <div class="hajera-hero-metrics">
                    <div class="hero-progress-block">
                        <div class="hero-progress-labels">
                            <span>Total Library Engagement</span>
                            <strong>${h(overallPercent)}%</strong>
                        </div>
                        <div class="hero-progress-track">
                            <div class="hero-progress-fill" style="width: ${h(overallPercent)}%;"></div>
                        </div>
                    </div>
                    <div class="hero-mini-stats hero-stats-6">
                        <div class="hero-mini-stat stat-watchtime" title="Total real watch time">
                            <span class="mini-num" id="hajeraTotalWatchTime">${h(watchStats.totalFormatted)}</span>
                            <span class="mini-label">Total Time</span>
                        </div>
                        <div class="hero-mini-stat stat-todaytime" title="Watch time today">
                            <span class="mini-num" id="hajeraTodayWatchTime">${h(watchStats.todayFormatted)}</span>
                            <span class="mini-label">Today</span>
                        </div>
                        <div class="hero-mini-stat stat-complete">
                            <span class="mini-num">${h(completedCount)}</span>
                            <span class="mini-label">Completed</span>
                        </div>
                        <div class="hero-mini-stat stat-watching">
                            <span class="mini-num">${h(inProgressCount)}</span>
                            <span class="mini-label">Watching</span>
                        </div>
                        <div class="hero-mini-stat stat-opened">
                            <span class="mini-num">${h(openedCount)}</span>
                            <span class="mini-label">Opened</span>
                        </div>
                        <div class="hero-mini-stat stat-unwatched">
                            <span class="mini-num">${h(unwatchedCount)}</span>
                            <span class="mini-label">Unwatched</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ========================================================
                 SESSION & ACCESS MANAGEMENT CENTER (MUAJ & HAJERA)
                 ======================================================== -->
            <div class="access-control-card ${hajeraBlocked ? 'is-blocked' : ''}" id="sessionsManagementSection">
                <div class="access-control-header">
                    <div class="access-control-title-group">
                        <div class="icon-bubble icon-shield">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                            </svg>
                        </div>
                        <div>
                            <h3 class="access-control-heading">Active Sessions &amp; Security Control</h3>
                            <p class="access-control-subtitle">Real-time device tracking, individual termination &amp; user access controls</p>
                        </div>
                    </div>
                    <div class="access-status-badges">
                        <span class="session-count-badge session-badge-muaj" id="muajSessionBadge" title="Muaj Active Sessions">
                            <span class="badge-icon">👑</span>
                            <span id="muajSessionText">${h(muajSessionCount)} Muaj Session${muajSessionCount !== 1 ? 's' : ''}</span>
                        </span>
                        <span class="session-count-badge session-badge-hajera" id="hajeraSessionBadge" title="Hajera Active Sessions">
                            <span class="badge-icon">💖</span>
                            <span id="hajeraSessionText">${h(hajeraSessionCount)} Hajera Session${hajeraSessionCount !== 1 ? 's' : ''}</span>
                        </span>
                        ${hajeraBlocked
                            ? '<span class="block-status-badge blocked" id="hajeraBlockStatusBadge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="12" height="12"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg> Hajera Blocked</span>'
                            : '<span class="block-status-badge active" id="hajeraBlockStatusBadge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="12" height="12"><polyline points="20 6 9 17 4 12"/></svg> Hajera Active</span>'
                        }
                    </div>
                </div>

                <div class="access-control-body">
                    <!-- Quick Force-Logout Action Grid -->
                    <div class="access-actions-grid">
                        <!-- Hajera Control Box -->
                        <div class="access-box access-box-hajera">
                            <div class="access-box-header">
                                <div class="access-box-title">
                                    <span class="box-icon">💖</span>
                                    <h4>Hajera Access Control</h4>
                                </div>
                                <span class="access-box-pill ${hajeraBlocked ? 'pill-blocked' : 'pill-active'}">${hajeraBlocked ? 'Blocked' : 'Allowed'}</span>
                            </div>
                            <p class="access-box-desc">Hajera-র সমস্ত active session ধ্বংস করুন অথবা ওয়েবসাইটের অ্যাক্সেস সাময়িকভাবে রেস্ট্রিক্ট করুন।</p>
                            
                            <div class="access-box-btns">
                                <form action="/admin/hajera/logout-sessions" method="POST" data-confirm="Hajera-র সব active sessions এখনই logout করতে চান?">
                                    <input type="hidden" name="_csrf" value="${h(csrfToken)}">
                                    <button type="submit" class="btn-access-action btn-logout-sessions" id="btnHajeraLogoutAll" ${hajeraSessionCount === 0 ? 'disabled' : ''}>
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15">
                                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                                            <polyline points="16 17 21 12 16 7"/>
                                            <line x1="21" y1="12" x2="9" y2="12"/>
                                        </svg>
                                        <span>Force Logout Hajera</span>
                                    </button>
                                </form>

                                ${hajeraBlocked
                                    ? `<form action="/admin/hajera/unblock" method="POST" data-confirm="Hajera-কে unblock করতে চান? আবার login করতে পারবে।">
                                        <input type="hidden" name="_csrf" value="${h(csrfToken)}">
                                        <button type="submit" class="btn-access-action btn-unblock">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15">
                                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                                                <path d="M7 11V7a5 5 0 0 1 9.9-1"/>
                                            </svg>
                                            <span>Unblock Hajera</span>
                                        </button>
                                       </form>`
                                    : `<form action="/admin/hajera/block" method="POST" data-confirm="Hajera-কে block করতে চান? সব sessions সাথে সাথে ধ্বংস হয়ে যাবে!" class="block-form-inline">
                                        <input type="hidden" name="_csrf" value="${h(csrfToken)}">
                                        <input type="text" name="reason" class="block-reason-input" placeholder="Block reason (optional)..." maxlength="150" />
                                        <button type="submit" class="btn-access-action btn-block">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15">
                                                <circle cx="12" cy="12" r="10"/>
                                                <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/>
                                            </svg>
                                            <span>Block</span>
                                        </button>
                                       </form>`
                                }
                            </div>
                            ${hajeraBlocked && hajeraBlockReason ? `<div class="block-reason-display"><strong>🚫 Blocked Reason:</strong> ${h(hajeraBlockReason)}</div>` : ''}
                        </div>

                        <!-- Muaj Admin Control Box -->
                        <div class="access-box access-box-muaj">
                            <div class="access-box-header">
                                <div class="access-box-title">
                                    <span class="box-icon">👑</span>
                                    <h4>Muaj Admin Session Control</h4>
                                </div>
                                <span class="access-box-pill pill-muaj">Admin</span>
                            </div>
                            <p class="access-box-desc">অন্যান্য ডিভাইস (মোবাইল/অন্যান্য ব্রাউজার) থেকে Muaj-এর সেশন বন্ধ করুন অথবা জরুরি ফোর্স লগআউট করুন।</p>
                            
                            <div class="access-box-btns">
                                <form action="/admin/muaj/logout-other-sessions" method="POST" data-confirm="Muaj-এর অন্যান্য সব ডিভাইস থেকে সেশন লগআউট করতে চান? আপনার বর্তমান ডিভাইসটি সচল থাকবে।">
                                    <input type="hidden" name="_csrf" value="${h(csrfToken)}">
                                    <button type="submit" class="btn-access-action btn-logout-other" id="btnMuajLogoutOther" ${muajSessionCount <= 1 ? 'disabled' : ''}>
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15">
                                            <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
                                            <line x1="8" y1="21" x2="16" y2="21"/>
                                            <line x1="12" y1="17" x2="12" y2="21"/>
                                        </svg>
                                        <span>Logout Other Devices</span>
                                    </button>
                                </form>

                                <form action="/admin/muaj/logout-all-sessions" method="POST" data-confirm="⚠️ সতর্কতা: এটি Muaj-এর বর্তমান ডিভাইস সহ সমস্ত সেশন বন্ধ করে দেবে! আপনি এখনই লগআউট হয়ে যাবেন। চালিয়ে যেতে চান?">
                                    <input type="hidden" name="_csrf" value="${h(csrfToken)}">
                                    <button type="submit" class="btn-access-action btn-logout-all-danger" id="btnMuajLogoutAll">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15">
                                            <path d="M18.36 6.64a9 9 0 1 1-12.73 0"/>
                                            <line x1="12" y1="2" x2="12" y2="12"/>
                                        </svg>
                                        <span>Logout All (Global)</span>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>

                    <!-- Detailed Active Sessions List (Table & Cards) -->
                    <div class="detailed-sessions-container">
                        <div class="detailed-sessions-header">
                            <div class="detailed-sessions-title-group">
                                <div class="icon-bubble icon-cyan">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                                        <rect x="2" y="2" width="20" height="20" rx="2.18" ry="2.18"/>
                                        <line x1="7" y1="2" x2="7" y2="22"/>
                                        <line x1="17" y1="2" x2="17" y2="22"/>
                                        <line x1="2" y1="12" x2="22" y2="12"/>
                                    </svg>
                                </div>
                                <div>
                                    <h4 class="detailed-sessions-heading">Connected Device Sessions</h4>
                                    <span class="detailed-sessions-sub" id="detailedSessionsSub">Total <strong id="detailedSessionsCount">${h(detailedSessions.length)}</strong> active session${detailedSessions.length !== 1 ? 's' : ''} currently authenticated</span>
                                </div>
                            </div>
                        </div>

                        <!-- Desktop Table View -->
                        <div class="admin-table-wrap sessions-desktop-table">
                            <table class="admin-table sessions-table" id="sessionsDesktopTable">
                                <thead>
                                    <tr>
                                        <th style="width: 150px;">User</th>
                                        <th>Device / Browser</th>
                                        <th style="width: 140px;">IP Address</th>
                                        <th style="width: 150px;">Login Time</th>
                                        <th style="width: 130px;">Last Active</th>
                                        <th style="width: 150px;">Status</th>
                                        <th style="width: 120px; text-align: right;">Action</th>
                                    </tr>
                                </thead>
                                <tbody id="sessionsTableBody">
                                    ${sessionsTableRows}
                                </tbody>
                            </table>
                        </div>

                        <!-- Mobile Touch Cards View -->
                        <div class="sessions-mobile-list" id="sessionsMobileList">
                            ${sessionsCardsHtml}
                        </div>
                    </div>
                </div>
            </div>

            <!-- Interactive Android Filter Chips Carousel -->
            <div class="hajera-filter-carousel">
                <div class="hajera-chips-track" id="hajeraFilterChips">
                    <button type="button" class="hajera-chip active" data-filter="all">
                        <span class="chip-label">All</span>
                        <span class="chip-count">${h(totalVideos)}</span>
                    </button>
                    <button type="button" class="hajera-chip chip-watching" data-filter="watching">
                        <span class="chip-dot dot-watching"></span>
                        <span class="chip-label">Watching</span>
                        <span class="chip-count">${h(inProgressCount)}</span>
                    </button>
                    <button type="button" class="hajera-chip chip-completed" data-filter="completed">
                        <span class="chip-dot dot-completed"></span>
                        <span class="chip-label">Completed</span>
                        <span class="chip-count">${h(completedCount)}</span>
                    </button>
                    <button type="button" class="hajera-chip chip-opened" data-filter="opened">
                        <span class="chip-dot dot-opened"></span>
                        <span class="chip-label">Opened</span>
                        <span class="chip-count">${h(openedCount)}</span>
                    </button>
                    <button type="button" class="hajera-chip chip-unwatched" data-filter="unwatched">
                        <span class="chip-dot dot-unwatched"></span>
                        <span class="chip-label">Unwatched</span>
                        <span class="chip-count">${h(unwatchedCount)}</span>
                    </button>
                    <button type="button" class="hajera-chip chip-timeline" data-filter="timeline">
                        <span class="chip-label">📜 Activity Timeline</span>
                        <span class="chip-count" id="hajeraTimelineCount">${h(activityTimeline.length)}</span>
                    </button>
                </div>
            </div>

            <!-- Live Search / Quick Filter Bar -->
            <div class="hajera-search-bar" id="hajeraSearchBarWrap">
                <div class="hajera-search-input-wrap">
                    <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                        <circle cx="11" cy="11" r="8"/>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                    </svg>
                    <input type="text" id="hajeraSearchInput" class="hajera-search-input" placeholder="Search Hajera's video logs..." autocomplete="off" />
                    <button type="button" class="search-clear-btn" id="hajeraSearchClear" style="display:none;" title="Clear search">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14">
                            <line x1="18" y1="6" x2="6" y2="18"/>
                            <line x1="6" y1="6" x2="18" y2="18"/>
                        </svg>
                    </button>
                </div>
                <div class="hajera-search-status" id="hajeraFilterCount">Showing <strong>${h(hajeraActivityList.length)}</strong> of ${h(hajeraActivityList.length)}</div>
            </div>

            <!-- Activity Timeline Feed View (Shown when Timeline chip is selected) -->
            <div class="hajera-timeline-feed" id="hajeraTimelineFeed" style="display: none;">
                <div class="timeline-feed-header">
                    <h4>Real-time Activity & Session History</h4>
                    <span class="timeline-feed-sub">Live audit trail of playback, logins, comments & presence</span>
                </div>
                <div class="timeline-list" id="hajeraTimelineList">
                    ${timelineHtml}
                </div>
            </div>

            <!-- Mobile Android Touch Cards View -->
            <div class="hajera-android-cards-list" id="hajeraCardsList">
                ${hajeraCardsHtml}
            </div>

            <div class="hajera-filtered-empty" id="hajeraFilteredEmpty" style="display:none;">
                <div class="filtered-empty-icon">🔍</div>
                <h4>No matching videos found</h4>
                <p>Try switching filters or changing your search terms.</p>
                <button type="button" class="btn btn-ghost btn-sm" id="hajeraResetFilterBtn">Reset Filter</button>
            </div>

            <!-- Desktop View: High-density Table (>= 900px) -->
            <div class="admin-table-wrap hajera-desktop-table">
                <table class="admin-table hajera-activity-table" id="hajeraDesktopTable">
                    <thead>
                        <tr>
                            <th style="width: 64px;">Preview</th>
                            <th>Video Title</th>
                            <th style="width: 140px;">Progress</th>
                            <th style="width: 130px;">Time Spent</th>
                            <th style="width: 130px;">Status</th>
                            <th style="width: 110px;">Last Active</th>
                        </tr>
                    </thead>
                    <tbody>${hajeraRows}</tbody>
                </table>
            </div>
        </section>

        <!-- Import Queue & Failed Imports Grid -->
        <section class="admin-jobs-grid">
            <div class="admin-section-card">
                <div class="section-card-header">
                    <div class="card-title-group">
                        <div class="icon-bubble icon-cyan">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                                <polyline points="7 10 12 15 17 10"/>
                                <line x1="12" y1="15" x2="12" y2="3"/>
                            </svg>
                        </div>
                        <h2>Import Queue</h2>
                    </div>
                    <span class="count-pill">${h(activeJobs.length)} active</span>
                </div>
                <div class="jobs-list">${jobRows}</div>
            </div>

            <div class="admin-section-card">
                <div class="section-card-header">
                    <div class="card-title-group">
                        <div class="icon-bubble icon-coral">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                                <circle cx="12" cy="12" r="10"/>
                                <line x1="15" y1="9" x2="9" y2="15"/>
                                <line x1="9" y1="9" x2="15" y2="15"/>
                            </svg>
                        </div>
                        <h2>Failed Imports</h2>
                    </div>
                    <span class="count-pill error-pill">${h(failedJobs.length)} recent</span>
                </div>
                <div class="jobs-list">${failedRows}</div>
            </div>
        </section>

        <!-- Recent Uploaded Videos Section -->
        <section class="admin-section-card">
            <div class="section-card-header">
                <div class="card-title-group">
                    <div class="icon-bubble icon-amber">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                            <rect x="2" y="2" width="20" height="20" rx="2.18" ry="2.18"/>
                            <line x1="7" y1="2" x2="7" y2="22"/>
                            <line x1="17" y1="2" x2="17" y2="22"/>
                            <line x1="2" y1="12" x2="22" y2="12"/>
                            <line x1="2" y1="7" x2="7" y2="7"/>
                            <line x1="2" y1="17" x2="7" y2="17"/>
                            <line x1="17" y1="17" x2="22" y2="17"/>
                            <line x1="17" y1="7" x2="22" y2="7"/>
                        </svg>
                    </div>
                    <h2>Recent Videos</h2>
                </div>
                <span class="count-pill">${h(formatBytes(stats.videoBytes))} stored</span>
            </div>

            <!-- Desktop Table -->
            <div class="admin-table-wrap admin-desktop-videos-table">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Uploader</th>
                            <th>Size</th>
                            <th>Duration</th>
                            <th>Quality</th>
                            <th>Added</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>${videoRows}</tbody>
                </table>
            </div>

            <!-- Mobile Android Video Cards -->
            <div class="admin-android-videos-list">
                ${videoCardsHtml}
            </div>
        </section>
    </main>

    <!-- Mobile Bottom Navigation Bar -->
    <nav class="mobile-bottom-bar" id="mobileBottomBar" aria-label="Bottom Navigation">
        <a href="/dashboard" class="bottom-nav-item" aria-label="Library">
            <div class="bottom-nav-icon-wrap">
                <svg class="nav-icon-outline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" width="24" height="24" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="7" height="7" rx="2.5"/>
