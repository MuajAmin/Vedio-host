            <!-- Desktop Table -->
            <div class="admin-table-wrap admin-desktop-videos-table">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Uploader</th>
                            <th>Size</th>
