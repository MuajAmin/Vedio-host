            statusIconCorner = '<span class="card-thumb-status-dot dot-unwatched" title="Not seen yet"></span>';
        } else if (isCompleted) {
            statusKey = 'completed';
            statusBadge = '<span class="activity-badge badge-completed"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="11" height="11"><polyline points="20 6 9 17 4 12"/></svg> Completed</span>';
            statusIconCorner = '<span class="card-thumb-status-dot dot-completed" title="Completed"></span>';
        } else if (isInProgress) {
            statusKey = 'watching';
            statusBadge = `<span class="activity-badge badge-progress"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="11" height="11"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg> Watching (${percent}%)</span>`;
            statusIconCorner = '<span class="card-thumb-status-dot dot-watching" title="Currently watching"></span>';
        } else {
            statusKey = 'opened';
            statusBadge = '<span class="activity-badge badge-opened"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="11" height="11"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg> Opened</span>';
            statusIconCorner = '<span class="card-thumb-status-dot dot-opened" title="Opened"></span>';
        }

        const thumbImg = item.thumbnail
            ? `<img src="/thumbnails/${h(item.thumbnail)}" alt="${h(item.title)}" class="hajera-card-thumb-img" loading="lazy" />`
            : '<div class="hajera-card-thumb-placeholder"><svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20"><polygon points="6,4 20,12 6,20"/></svg></div>';

        const safeTitle = String(item.title || '');
        const durationText = item.formatted_duration || formatSeconds(dur);
        const timeSpentText = isWatched ? `${formatSeconds(pos)} / ${durationText}` : durationText;

        return `<a href="/watch/${encodeURIComponent(item.video_id)}" 
            class="hajera-android-card status-${statusKey} ${isWatched ? 'is-watched' : 'is-unwatched'}" 
            data-status="${statusKey}" 
            data-title="${h(safeTitle.toLowerCase())}">
            <div class="hajera-card-thumb-box">
                ${thumbImg}
                ${statusIconCorner}
                <span class="hajera-thumb-duration">${h(durationText)}</span>
            </div>
            <div class="hajera-card-content">
                <div class="hajera-card-top-row">
                    <h4 class="hajera-card-title">${h(safeTitle)}</h4>
                    <span class="hajera-card-rel-time">${isWatched ? h(timeAgo(watchedTime)) : 'Not seen'}</span>
