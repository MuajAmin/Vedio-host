                <div class="stat-text-group">
                    <span>Watch Activity</span>
                    <strong>${h(stats.progressCount || 0)}</strong>
                </div>
            </div>
            <div class="admin-stat stat-orphans">
                <div class="stat-icon-wrap icon-orphans">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
                        <path d="M3 6h18"/>
