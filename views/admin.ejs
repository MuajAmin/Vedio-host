        const uploaderName = uploader === 'hajera' ? 'Hajera' : (uploader === 'muaj' ? 'Muaj' : uploader);

        const hj = hajeraProgressMap.get(v.id);
        let hjStatusBadge = '<span class="activity-badge badge-unwatched">Unseen</span>';
        if (hj && hj.hajera_watched_at) {
            const hPos = Number(hj.position_seconds || 0);
            const hDur = Number(hj.duration_seconds || 0);
            const hPct = hDur > 0 ? Math.min(100, Math.round((hPos / hDur) * 100)) : 100;
            if (hDur > 0 && hPos >= hDur - 15) {
                hjStatusBadge = '<span class="activity-badge badge-completed">✓ Done</span>';
            } else if (hPos >= 10) {
                hjStatusBadge = `<span class="activity-badge badge-progress">⏱️ ${hPct}%</span>`;
            } else {
                hjStatusBadge = '<span class="activity-badge badge-opened">👁️ Opened</span>';
            }
        }

        const microThumb = v.thumbnail
            ? `<img src="/thumbnails/${h(v.thumbnail)}" alt="" class="admin-micro-thumb" loading="lazy" />`
            : '<div class="admin-micro-thumb-fallback">🎬</div>';

        return `
        <div class="admin-master-video-card" data-title="${h(String(v.title || '').toLowerCase())}">
            <div class="master-card-top">
                <div class="compact-thumb-wrap">
                    ${microThumb}
                    <span class="compact-micro-dur">${h(v.duration || '-')}</span>
                </div>
                <div class="master-card-info">
                    <a href="/watch/${safeId}" class="master-card-title" target="_blank">${h(v.title)}</a>
                    <div class="master-card-meta">
                        <span>${h(uploaderName)}</span> • <span>${formatBytes(safeSize)}</span> • <span>${timeAgo(v.uploaded_at)}</span>
                    </div>
                </div>
            </div>
            <div class="master-card-bottom">
                <div class="master-card-badges">
                    ${hjStatusBadge}
                    ${isOnR2 ? '<span class="compact-chip chip-r2">⚡ R2</span>' : '<span class="compact-chip chip-vps-only">⚠️ VPS</span>'}
                </div>
                <div class="master-card-actions">
                    ${!isOnR2 ? `<button type="button" class="btn-android-sync-r2 btn-xs" onclick="syncSingleVideo('${safeId}', '${safeFn}', ${safeSize}, this)">Sync</button>` : ''}
                    <a href="/watch/${safeId}" class="btn btn-ghost btn-xs" target="_blank">Watch</a>
                    <form action="/delete/${safeId}" method="POST" data-confirm="Delete '${h(v.title)}'?" style="margin:0;">
                        <input type="hidden" name="_csrf" value="${h(csrfToken)}">
                        <button type="submit" class="btn btn-danger btn-xs">Delete</button>
                    </form>
                </div>
            </div>
        </div>
    `;}).join('');
%>
