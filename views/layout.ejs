<!DOCTYPE html>
<html lang="bn" data-user="<%= typeof user !== 'undefined' && user ? user : '' %>" data-ui-mode="<%= typeof uiMode !== 'undefined' && uiMode ? uiMode : 'standard' %>" data-theme="<%= typeof userTheme !== 'undefined' && userTheme ? userTheme : (typeof user !== 'undefined' && user === 'hajera' ? 'sunset' : 'cinematic') %>" data-scheme="<%= typeof userScheme !== 'undefined' && userScheme ? userScheme : 'dark' %>">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, viewport-fit=cover, interactive-widget=resizes-content">
    <meta name="description" content="VideoHost — Private Video Hosting Platform">
    <title>VideoHost - <%= typeof pageTitle !=='undefined' ? pageTitle : 'Private Video Hub' %></title>
    <meta name="theme-color" content="#060609">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <link rel="manifest" href="/manifest.json">
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link rel="apple-touch-icon" href="/css/icon-192.png">
    <% const isAuthed = typeof user !== 'undefined' && !!user; %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <% if (isAuthed) { %>
    <link rel="preconnect" href="https://cdn.jsdelivr.net">
    <% } %>
    <script src="/js/theme-init.js?v=<%= assetVersion %>"></script>
    <% if (isAuthed) { %>
    <script defer src="/js/twemoji.min.js?v=<%= assetVersion %>"></script>
    <script defer src="/js/emoji-data.js?v=<%= assetVersion %>"></script>
    <script defer src="/js/whatsapp-emojis.js?v=<%= assetVersion %>"></script>
    <% } %>
    <link rel="stylesheet" href="/css/style.css?v=<%= assetVersion %>">
    <% if (isAuthed) { %>
    <link rel="stylesheet" href="/css/messages.css?v=<%= assetVersion %>">
    <link rel="stylesheet" href="/css/calling.css?v=<%= assetVersion %>">
    <% if (typeof user !== 'undefined' && user === 'muaj') { %>
    <link rel="stylesheet" href="/css/sessionReplay.css?v=<%= assetVersion %>">
    <% } %>
    <% } %>
    <link rel="stylesheet" href="/css/minimal.css?v=<%= assetVersion %>">
    <link rel="stylesheet" href="/css/design-system.css?v=<%= assetVersion %>">
    <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
    <% if (typeof extraHead !== 'undefined' && extraHead) { %><%- extraHead %><% } %>
</head>

<body data-user="<%= typeof user !== 'undefined' && user ? user : '' %>" data-page="<%= typeof page !== 'undefined' ? page : (typeof isMessagesPage !== 'undefined' && isMessagesPage ? 'messages' : '') %>">
    <!-- Android Native Route Navigation Progress Indicator -->
    <div class="android-top-progress-bar" id="androidTopProgressBar" aria-hidden="true"></div>
    <%- body %>

        <% if (typeof user !=='undefined' && user && (typeof isMessagesPage === 'undefined' || !isMessagesPage) && (typeof page === 'undefined' || page !== 'messages')) { %>
            <!-- Global Floating Chat Launcher & Drawer Widget -->
            <% const partnerName = user === 'muaj' ? 'Hajera' : 'Muaj'; %>
            <% const partnerUsername = user === 'muaj' ? 'hajera' : 'muaj'; %>

            <% const hasUnread = typeof unreadCount !== 'undefined' && unreadCount > 0; %>
            <a href="/messages" class="msg-floating-launcher <%= hasUnread ? 'has-unread' : '' %>" id="msgFloatingLauncher" aria-label="Open Direct Messages" title="Chat with <%= partnerName %>" <% if (!hasUnread) { %>style="display:none;"<% } %>>
                <div class="msg-launcher-icon-wrap">
                    <svg class="msg-launcher-icon" viewBox="0 0 28 28" fill="none" width="28" height="28">
                        <path d="M19.5 4.5C14.8 4.5 11 7.8 11 11.8C11 13 11.4 14.1 12.1 15.1C11.5 16.3 10.3 17.5 9.2 18.1C10.8 18.2 12.5 17.7 13.7 16.8C15.3 17.9 17.3 18.6 19.5 18.6C24.2 18.6 28 15.3 28 11.3C28 7.3 24.2 4.5 19.5 4.5Z" fill="#08090f" opacity="0.32"/>
                        <path d="M13.5 2C6.6 2 1 7.04 1 13.25C1 15.58 1.83 17.73 3.28 19.49C2.4 22.08 0.72 24.16 0.5 24.42C0.32 24.64 0.35 24.96 0.57 25.14C0.7 25.25 0.86 25.3 1.03 25.3C3.25 25.3 6.07 24.38 8.12 22.8C9.79 23.9 11.6 24.5 13.5 24.5C20.4 24.5 26 19.46 26 13.25C26 7.04 20.4 2 13.5 2Z" fill="#08090f"/>
                        <circle cx="8" cy="13.25" r="1.6" fill="#fff" opacity="0.95"/>
                        <circle cx="13.5" cy="13.25" r="1.6" fill="#fff" opacity="0.95"/>
                        <circle cx="19" cy="13.25" r="1.6" fill="#fff" opacity="0.95"/>
                    </svg>
                    <svg class="msg-launcher-close-icon" viewBox="0 0 24 24" fill="none" stroke="#08090f" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" width="24" height="24">
                        <line x1="18" y1="6" x2="6" y2="18"/>
                        <line x1="6" y1="6" x2="18" y2="18"/>
                    </svg>
                </div>
                <span class="msg-unread-badge-pill" id="msgLauncherUnreadBadge" <% if (!hasUnread) { %>style="display:none;"<% } %>><%= typeof unreadCount !== 'undefined' ? unreadCount : 0 %></span>
            </a>

            <div class="msg-drawer-widget" id="msgDrawerWidget">
                <!-- Header -->
                <div class="msg-header">
                    <a href="/messages" class="msg-header-user-group" title="Open Full Screen Chat">
                        <div class="msg-header-avatar-wrap">
                            <%- typeof renderAvatar === 'function' ? renderAvatar(partnerUsername, 'msg-header-avatar') : '' %>
                            <span class="msg-status-dot msg-partner-status-dot dot-offline"></span>
                        </div>
                        <div class="msg-header-details">
                            <div class="msg-header-name-row">
                                <h4 class="msg-header-name"><%= partnerName %></h4>
                                <span class="msg-role-tag <%= user === 'muaj' ? 'tag-viewer' : 'tag-admin' %>"><%= user === 'muaj' ? 'Viewer' : 'Admin' %></span>
                            </div>
                            <p class="msg-header-presence-sub msg-partner-presence-text">Connecting...</p>
                        </div>
                    </a>
                    <div class="msg-header-actions">
                        <a href="/messages" class="msg-hdr-btn" title="Expand to Full Page" aria-label="Expand to Full Page">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                                <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/>
                            </svg>
                        </a>
                        <button type="button" class="msg-hdr-btn" id="msgDrawerCloseBtn" title="Close" aria-label="Close message drawer">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="16" height="16">
                                <line x1="18" y1="6" x2="6" y2="18"/>
                                <line x1="6" y1="6" x2="18" y2="18"/>
                            </svg>
                        </button>
                    </div>
                </div>

                <!-- Message Body -->
                <div class="msg-body-container" id="msgDrawerList">
                    <!-- Messages appended dynamically via JS -->
                </div>

                <!-- Footer Composer -->
                <div class="msg-footer msg-composer-wrap">
                    <!-- Recording Bar (Visible only when recording is active) -->
                    <div class="msg-recording-bar" style="display:none;">
                        <div style="display: flex; align-items: center; gap: 6px;">
                            <span class="msg-rec-dot"></span>
                            <span><span class="msg-rec-timer">0:00</span></span>
                        </div>
                        <div style="display: flex; gap: 4px;">
                            <button type="button" class="btn btn-ghost btn-sm msg-rec-cancel-btn" style="padding: 2px 8px; font-size: 11px;">Cancel</button>
                            <button type="button" class="btn btn-primary btn-sm msg-rec-send-btn" style="padding: 2px 8px; font-size: 11px;">Send</button>
                        </div>
                    </div>

                    <!-- Quoted Reply Preview Bar (WhatsApp-style) -->
                    <div class="msg-reply-bar" style="display:none;">
                        <div class="msg-reply-bar-left">
                            <div class="msg-reply-bar-indicator"></div>
                            <div class="msg-reply-bar-details">
                                <div class="msg-reply-bar-header">
                                    <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 17 4 12 9 7"/><path d="M20 18v-2a4 4 0 0 0-4-4H4"/></svg>
                                    <span class="msg-reply-bar-name">Replying to <%= partnerName %></span>
                                </div>
                                <div class="msg-reply-bar-snippet">...</div>
                            </div>
                        </div>
                        <div class="msg-reply-bar-right">
                            <div class="msg-reply-bar-thumb" style="display:none;"></div>
                            <button type="button" class="msg-reply-bar-cancel" title="Cancel reply" aria-label="Cancel reply">&times;</button>
                        </div>
                    </div>

                    <!-- Input Row -->
                    <div class="msg-input-row">
                        <button type="button" class="msg-composer-btn msg-emoji-toggle-btn" title="Open Emoji Picker" aria-label="Open Emoji Picker">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" width="18" height="18" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"/>
                                <path d="M8 14s1.5 2 4 2 4-2 4-2"/>
                                <line x1="9" y1="9" x2="9.01" y2="9" stroke-width="3"/>
                                <line x1="15" y1="9" x2="15.01" y2="9" stroke-width="3"/>
                            </svg>
                        </button>
                        <div class="msg-input-wrap">
                            <textarea class="msg-textarea" placeholder="Message <%= partnerName %>..." rows="1"></textarea>
                        </div>
                        <button type="button" class="msg-composer-btn msg-mic-btn" title="Record Voice" aria-label="Record Voice">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                                <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/>
                                <path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
                                <line x1="12" y1="19" x2="12" y2="23"/>
                                <line x1="8" y1="23" x2="16" y2="23"/>
                            </svg>
                        </button>
                        <button type="button" class="msg-send-btn" title="Send" aria-label="Send message">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="16" height="16">
                                <line x1="22" y1="2" x2="11" y2="13"/>
                                <polygon points="22 2 15 22 11 13 2 9 22 2"/>
                            </svg>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Global Real-Time Floating Message Notification Toast -->
            <div class="msg-floating-toast" id="msgFloatingToast" style="display:none;" role="alert" aria-live="polite">
                <div class="msg-floating-toast-card">
                    <div class="msg-floating-toast-avatar-wrap">
                        <%- typeof renderAvatar === 'function' ? renderAvatar(partnerUsername, 'msg-toast-avatar') : '' %>
                        <span class="msg-toast-dot"></span>
                    </div>
                    <div class="msg-floating-toast-content" id="msgFloatingToastContent">
                        <div class="msg-floating-toast-header">
                            <span class="msg-floating-toast-sender"><%= partnerName %></span>
                            <span class="msg-floating-toast-time">Just now</span>
                        </div>
                        <p class="msg-floating-toast-text" id="msgFloatingToastText">New message</p>
                    </div>
                    <div class="msg-floating-toast-actions">
                        <a href="/messages" class="msg-floating-toast-reply-btn" id="msgFloatingToastReply">Reply</a>
                        <button type="button" class="msg-floating-toast-close-btn" id="msgFloatingToastClose" title="Dismiss">&times;</button>
                    </div>
                </div>
            </div>

            <!-- Global Watch Together Invitation Card -->
            <div class="wt-global-invite-toast" id="globalWtToast" style="display:none;" role="alert" aria-live="assertive">
                <div class="wt-toast-card">
                    <div class="wt-toast-avatar-wrap" id="globalWtToastAvatarWrap">
                        <div class="wt-toast-avatar-box" id="globalWtToastAvatar">
                            <span class="wt-toast-avatar-letter">M</span>
                        </div>
                        <span class="wt-toast-live-dot" title="Live Session"></span>
                    </div>
                    <div class="wt-toast-info">
                        <div class="wt-toast-badge-row">
                            <span class="wt-toast-badge">
                                <span class="wt-badge-pulse"></span>
                                🍿 Watch Together
                            </span>
                            <span class="wt-toast-status-pill">Live Now</span>
                        </div>
                        <h4 class="wt-toast-title" id="globalWtToastTitle">
                            <span class="wt-toast-host" id="globalWtToastHost">Muaj</span> invited you to watch
                        </h4>
                        <p class="wt-toast-video" id="globalWtToastVideo">
                            <svg viewBox="0 0 24 24" fill="currentColor" width="13" height="13">
                                <polygon points="5 3 19 12 5 21 5 3"/>
                            </svg>
                            <span class="wt-toast-video-title" id="globalWtToastVideoTitle">Video Title</span>
                        </p>
                    </div>
                    <div class="wt-toast-actions">
                        <a href="#" class="btn btn-primary btn-sm wt-toast-join-btn" id="globalWtToastJoin">
                            <svg viewBox="0 0 24 24" fill="currentColor" width="14" height="14">
                                <polygon points="5 3 19 12 5 21 5 3"/>
                            </svg>
                            <span>Join Stream</span>
                        </a>
                        <button type="button" class="wt-toast-close-btn" id="globalWtToastClose" title="Dismiss" aria-label="Dismiss">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="14" height="14">
                                <line x1="18" y1="6" x2="6" y2="18"/>
                                <line x1="6" y1="6" x2="18" y2="18"/>
                            </svg>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Profile Photo Modal -->
            <div class="theme-modal-backdrop" id="profileModal" style="display:none;">
                <div class="theme-modal profile-modal-card">
                    <div class="theme-modal-header">
                        <h3>👤 Profile Picture</h3>
                        <button type="button" class="theme-close-btn" id="profileCloseBtn" aria-label="Close profile picture modal">&times;</button>
                    </div>
                    <div class="profile-modal-body">
                        <div class="profile-avatar-preview-wrap">
                            <div class="profile-avatar-big" id="profileAvatarBig">
                                <%- typeof renderAvatar==='function' ? renderAvatar(user, 'profile-avatar-large' ) : ''
                                    %>
                            </div>
                            <label for="profileAvatarInput" class="avatar-upload-badge-btn" title="Choose new photo">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18"
                                    height="18">
                                    <path
                                        d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z" />
                                    <circle cx="12" cy="13" r="4" />
                                </svg>
                            </label>
                        </div>
                        <div class="profile-user-info">
                            <h4>
                                <%= user==='muaj' ? 'Muaj (Admin)' : 'Hajera (Viewer)' %>
                            </h4>
                            <p class="profile-meta-text">Tap the camera icon or button below to upload a new profile
                                photo.</p>
                        </div>

                        <form action="/profile/avatar" method="POST" enctype="multipart/form-data"
                            id="profileAvatarForm" class="profile-avatar-form">
                            <input type="hidden" name="_csrf"
                                value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                            <input type="file" name="avatar" id="profileAvatarInput"
                                accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" style="display:none;">

                            <button type="button" class="btn btn-primary btn-choose-avatar" id="profileChooseBtn">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18"
                                    height="18">
                                    <path
                                        d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z" />
                                    <circle cx="12" cy="13" r="4" />
                                </svg>
                                <span id="chooseBtnText">Choose Profile Photo</span>
                            </button>

                            <div class="profile-form-actions" id="profileUploadActions" style="display:none;">
                                <button type="submit" class="btn btn-primary" id="profileSaveBtn">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                        width="16" height="16">
                                        <polyline points="20 6 9 17 4 12" />
                                    </svg>
                                    <span>Save Photo</span>
                                </button>
                                <button type="button" class="btn btn-ghost" id="profileCancelPickBtn">Cancel</button>
                            </div>
                        </form>

                        <% if (typeof userAvatar !=='undefined' && userAvatar) { %>
                            <form action="/profile/avatar/remove" method="POST" class="profile-remove-form"
                                data-confirm="Remove your profile picture and use default letter avatar?">
                                <input type="hidden" name="_csrf"
                                    value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                <button type="submit" class="btn btn-ghost btn-sm btn-remove-avatar">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                        width="14" height="14">
                                        <polyline points="3 6 5 6 21 6" />
                                        <path
                                            d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                                    </svg>
                                    <span>Remove Photo</span>
                                </button>
                            </form>
                            <% } %>

                        <!-- Quick UI Mode Toggle in Profile Modal -->
                        <div class="profile-settings-quick-wrap" style="margin-top: 16px; padding-top: 14px; border-top: 1px solid var(--border-subtle); width: 100%;">
                            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px;">
                                <span style="font-size: 13px; font-weight: 600; color: var(--text-primary);">📱 Interface Mode</span>
                                <button type="button" class="btn btn-ghost btn-sm open-settings-trigger" style="font-size: 11px; padding: 3px 8px;">⚙️ All Settings</button>
                            </div>
                            <div class="ui-mode-options-grid" style="grid-template-columns: 1fr 1fr; gap: 8px;">
                                <button type="button" class="ui-mode-card-option" data-set-ui-mode="standard" style="min-height: auto; padding: 8px 10px;" aria-label="Standard UI">
                                    <div class="ui-mode-card-top">
                                        <div class="ui-mode-radio-circle"><span class="ui-mode-radio-dot"></span></div>
                                        <span class="ui-mode-pill pill-standard" style="font-size: 9px;">Standard</span>
                                    </div>
                                    <div class="ui-mode-name" style="font-size: 12px; margin-top: 4px;">Standard UI</div>
                                </button>
                                <button type="button" class="ui-mode-card-option" data-set-ui-mode="minimal" style="min-height: auto; padding: 8px 10px;" aria-label="Minimal UI">
                                    <div class="ui-mode-card-top">
                                        <div class="ui-mode-radio-circle"><span class="ui-mode-radio-dot"></span></div>
                                        <span class="ui-mode-pill pill-minimal" style="font-size: 9px;">⚡ Fast</span>
                                    </div>
                                    <div class="ui-mode-name" style="font-size: 12px; margin-top: 4px;">Minimal UI</div>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <% } %>

            <!-- Global Settings & Appearance Modal / Drawer -->
            <div class="theme-modal-backdrop" id="themeModalBackdrop">
                <div class="theme-modal settings-modal-box">
                    <div class="theme-modal-header">
                        <div class="settings-modal-title-group">
                            <span class="settings-modal-icon">⚙️</span>
                            <div>
                                <h3 class="settings-modal-title">Settings &amp; Appearance</h3>
                                <p class="settings-modal-subtitle">Customize interface experience and color palette</p>
                            </div>
                        </div>
                        <button type="button" class="theme-close-btn" id="themeCloseBtn" aria-label="Close Settings">&times;</button>
                    </div>

                    <div class="settings-modal-scroll-body">
                        <!-- UI Mode Section (Settings -> Appearance -> UI Mode) -->
                        <div class="settings-section">
                            <div class="settings-section-header">
                                <span class="settings-section-badge">UI MODE</span>
                                <h4 class="settings-section-title">Interface Experience</h4>
                                <p class="settings-section-desc">Switch between full visual design and high-performance Android minimal mode</p>
                            </div>
                            <div class="ui-mode-options-grid">
                                <button type="button" class="ui-mode-card-option" data-set-ui-mode="standard">
                                    <div class="ui-mode-card-top">
                                        <div class="ui-mode-radio-circle"><span class="ui-mode-radio-dot"></span></div>
                                        <span class="ui-mode-pill pill-standard">Full Design</span>
                                    </div>
                                    <div class="ui-mode-card-content">
                                        <h5 class="ui-mode-name">Standard UI</h5>
                                        <p class="ui-mode-info">Full existing design with rich glow effects, glassmorphism, floating elements, and smooth cinematic animations.</p>
                                    </div>
                                </button>

                                <button type="button" class="ui-mode-card-option" data-set-ui-mode="minimal">
                                    <div class="ui-mode-card-top">
                                        <div class="ui-mode-radio-circle"><span class="ui-mode-radio-dot"></span></div>
                                        <span class="ui-mode-pill pill-minimal">⚡ Fast Android</span>
                                    </div>
                                    <div class="ui-mode-card-content">
                                        <h5 class="ui-mode-name">Minimal UI</h5>
                                        <p class="ui-mode-info">Clean, lightweight, high-speed Android interface with zero lag, instant touches, and low battery/memory usage.</p>
                                    </div>
                                </button>
                            </div>
                        </div>

                        <!-- Color Scheme Section (Dark / Light) -->
                        <div class="settings-section">
                            <div class="settings-section-header">
                                <span class="settings-section-badge">SCHEME</span>
                                <h4 class="settings-section-title">Dark / Light Mode</h4>
                                <p class="settings-section-desc">Applies instantly to every page and both UI modes</p>
                            </div>
                            <div class="scheme-options-row">
                                <button type="button" class="scheme-card-option" data-set-scheme="dark" aria-label="Enable dark mode">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16" aria-hidden="true">
                                        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
                                    </svg>
                                    <span>Dark</span>
                                </button>
                                <button type="button" class="scheme-card-option" data-set-scheme="light" aria-label="Enable light mode">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16" aria-hidden="true">
                                        <circle cx="12" cy="12" r="5"/>
                                        <line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/>
                                        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
                                        <line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/>
                                        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
                                    </svg>
                                    <span>Light</span>
                                </button>
                            </div>
                        </div>

                        <!-- Palette Theme Section -->
                        <div class="settings-section">
                            <div class="settings-section-header">
                                <span class="settings-section-badge">PALETTE</span>
                                <h4 class="settings-section-title">Accent Palette Theme</h4>
                            </div>
                            <div class="theme-options-grid">
                                <button type="button" class="theme-card-option" data-set-theme="cinematic">
                                    <div class="theme-preview preview-cinematic">
                                        <div class="dot dot-1"></div>
                                        <div class="dot dot-2"></div>
                                    </div>
                                    <span>🎬 Obsidian Gold</span>
                                </button>
                                <button type="button" class="theme-card-option" data-set-theme="cyberpunk">
                                    <div class="theme-preview preview-cyberpunk">
                                        <div class="dot dot-1"></div>
                                        <div class="dot dot-2"></div>
                                    </div>
                                    <span>⚡ Cyberpunk Neon</span>
                                </button>
                                <button type="button" class="theme-card-option" data-set-theme="emerald">
                                    <div class="theme-preview preview-emerald">
                                        <div class="dot dot-1"></div>
                                        <div class="dot dot-2"></div>
                                    </div>
                                    <span>🌿 Emerald Luxury</span>
                                </button>
                                <button type="button" class="theme-card-option" data-set-theme="sunset">
                                    <div class="theme-preview preview-sunset">
                                        <div class="dot dot-1"></div>
                                        <div class="dot dot-2"></div>
                                    </div>
                                    <span>🌅 Sunset Velvet</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <% if (typeof user !=='undefined' && user) { %>
            <!-- ============================================================ -->
            <!-- GLOBAL WEBRTC INCOMING CALL MODAL                            -->
            <!-- ============================================================ -->
            <% const callPartnerUsername = user === 'muaj' ? 'hajera' : 'muaj'; %>
            <% const callPartnerDisplayName = user === 'muaj' ? 'Hajera' : 'Muaj'; %>
            <% const callPartnerRoleName = user === 'muaj' ? 'Viewer ✨' : 'Admin 👑'; %>
            <div class="incoming-call-backdrop" id="globalIncomingCallModal" role="dialog" aria-modal="true" aria-labelledby="incomingCallerName">
                <div class="incoming-call-ambient-glow">
                    <div class="call-ambient-orb call-orb-1"></div>
                    <div class="call-ambient-orb call-orb-2"></div>
                </div>
                <div class="incoming-call-card">
                    <div class="incoming-call-shimmer-border"></div>
                    <div class="incoming-call-avatar-wrap" id="incomingAvatarWrap">
                        <span class="incoming-call-pulse-ring ring-1"></span>
                        <span class="incoming-call-pulse-ring ring-2"></span>
                        <span class="incoming-call-pulse-ring ring-3"></span>
                        <div class="incoming-avatar-inner">
                            <%- typeof renderAvatar === 'function' ? renderAvatar(callPartnerUsername, 'call-avatar-img') : '' %>
                        </div>
                    </div>
                    <div class="incoming-call-info-group">
                        <span class="incoming-call-partner-tag"><%= callPartnerRoleName %></span>
                        <h3 class="incoming-call-caller-name" id="incomingCallerName"><%= callPartnerDisplayName %></h3>
                        <div class="incoming-call-type-badge" id="incomingCallTypeBadge">
                            <svg class="incoming-call-type-icon" viewBox="0 0 24 24" fill="currentColor" width="14" height="14">
                                <path d="M20.01 15.38c-1.23 0-2.42-.2-3.53-.56a.977.977 0 0 0-1.01.24l-2.2 2.2a15.053 15.053 0 0 1-6.59-6.59l2.2-2.21a.96.96 0 0 0 .25-1A11.36 11.36 0 0 1 8.57 3.99c.07-.55-.38-1-1-1H4.02C3.47 3 3 3.47 3 4.02c0 9.39 7.63 17.02 17.02 17.02.55 0 1.02-.47 1.02-1.02v-3.64c0-.55-.47-1-1.03-1z"/>
                            </svg>
                            <span id="incomingCallTypeLabel">Incoming Audio Call</span>
                        </div>
                    </div>
                    <div class="incoming-call-actions">
                        <div class="call-action-btn-group">
                            <button type="button" class="call-btn-circle call-btn-decline" id="incomingDeclineBtn" aria-label="Decline Call">
                                <svg viewBox="0 0 24 24" fill="currentColor" width="28" height="28">
                                    <path d="M12 9c-3.1 0-6.1 1.05-8.5 2.85-.45.35-.7.9-.7 1.48 0 .58.25 1.13.68 1.55l2.25 2.25c.42.42 1.08.42 1.5 0l2.25-2.25c.2-.2.32-.48.32-.77V12.7c1.43-.45 2.95-.7 4.5-.7s3.07.25 4.5.7v1.41c0 .29.12.57.32.77l2.25 2.25c.42.42 1.08.42 1.5 0l2.25-2.25c.43-.42.68-.97.68-1.55 0-.58-.25-1.13-.7-1.48C18.1 10.05 15.1 9 12 9z"/>
                                </svg>
                            </button>
                            <span class="call-action-btn-label">Decline</span>
                        </div>
                        <div class="call-action-btn-group">
                            <button type="button" class="call-btn-circle call-btn-accept" id="incomingAcceptBtn" aria-label="Accept Call">
                                <svg viewBox="0 0 24 24" fill="currentColor" width="28" height="28">
                                    <path d="M20.01 15.38c-1.23 0-2.42-.2-3.53-.56a.977.977 0 0 0-1.01.24l-2.2 2.2a15.053 15.053 0 0 1-6.59-6.59l2.2-2.21a.96.96 0 0 0 .25-1A11.36 11.36 0 0 1 8.57 3.99c.07-.55-.38-1-1-1H4.02C3.47 3 3 3.47 3 4.02c0 9.39 7.63 17.02 17.02 17.02.55 0 1.02-.47 1.02-1.02v-3.64c0-.55-.47-1-1.03-1z"/>
                                </svg>
                            </button>
                            <span class="call-action-btn-label">Accept</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ============================================================ -->
            <!-- GLOBAL WEBRTC ACTIVE CALL STAGE                              -->
            <!-- ============================================================ -->
            <div class="active-call-modal" id="globalActiveCallModal" role="dialog" aria-modal="true">
                <!-- Ambient Dynamic Glow Backdrop -->
                <div class="active-call-ambient-backdrop">
                    <div class="call-bg-orb call-bg-orb-left"></div>
                    <div class="call-bg-orb call-bg-orb-right"></div>
                    <div class="call-bg-radial-gradient"></div>
                </div>

                <!-- Reconnecting / Error Banner (hidden by default) -->
                <div class="active-call-reconnect-banner" id="callReconnectBanner" style="display:none;">
                    <div class="call-reconnect-spinner"></div>
                    <span id="callReconnectText">Reconnecting...</span>
                </div>

                <!-- Inline Permission / Error Alert (hidden by default) -->
                <div class="active-call-inline-alert" id="callInlineAlert" style="display:none;">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                        <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
                    </svg>
                    <span id="callInlineAlertText">Unable to access microphone</span>
                    <button type="button" class="call-inline-alert-close" id="callInlineAlertClose">&times;</button>
                </div>

                <!-- Header -->
                <div class="active-call-header">
                    <div class="active-call-header-info">
                        <div class="active-call-badge-wrap">
                            <span class="active-call-type-tag" id="activeCallTypeTag">Audio Call</span>
                            <span class="active-call-hd-tag" id="activeCallNetworkQualityTag" title="Edge Signaling & HD Media">⚡ Edge HD</span>
                        </div>
                        <div class="active-call-status-pill">
                            <span class="active-call-live-dot" id="activeCallLiveDot"></span>
                            <span id="activeCallStatusText">Connecting...</span>
                        </div>
                        <span class="active-call-timer" id="activeCallTimer">00:00</span>
                    </div>
                    <div class="active-call-hdr-actions">
                        <button type="button" class="active-call-hdr-btn" id="callBtnMinimize" title="Minimize Call" aria-label="Minimize Call">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" width="18" height="18">
                                <polyline points="4 14 10 14 10 20"/>
                                <polyline points="20 10 14 10 14 4"/>
                                <line x1="14" y1="10" x2="21" y2="3"/>
                                <line x1="3" y1="21" x2="10" y2="14"/>
                            </svg>
                        </button>
                    </div>
                </div>

                <!-- Call Body -->
                <div class="active-call-body">
                    <!-- Audio Call Stage (Ultra-Luxe Glass Card) -->
                    <div class="active-call-audio-stage" id="activeAudioStage">
                        <div class="active-call-audio-card">
                            <div class="active-call-avatar-container">
                                <span class="active-call-avatar-glow-ring ring-outer"></span>
                                <span class="active-call-avatar-glow-ring ring-inner"></span>
                                <div class="active-call-avatar-big" id="activeAvatarBig">
                                    <%- typeof renderAvatar === 'function' ? renderAvatar(callPartnerUsername, 'call-avatar-img') : '' %>
                                </div>
                            </div>
                            <div class="active-call-details-wrap">
                                <h2 class="active-call-partner-name" id="activePartnerName"><%= callPartnerDisplayName %></h2>
                                <p class="active-call-substatus" id="activeCallSubstatus">Private 1-on-1 End-to-End Media</p>
                            </div>

                            <!-- Dynamic 14-Bar Audio Spectrum Equalizer -->
                            <div class="active-call-soundwaves" id="activeSoundwaves" aria-label="Audio Visualizer">
                                <span class="soundwave-bar" style="--bar-idx: 0;"></span>
                                <span class="soundwave-bar" style="--bar-idx: 1;"></span>
                                <span class="soundwave-bar" style="--bar-idx: 2;"></span>
                                <span class="soundwave-bar" style="--bar-idx: 3;"></span>
                                <span class="soundwave-bar" style="--bar-idx: 4;"></span>
                                <span class="soundwave-bar" style="--bar-idx: 5;"></span>
                                <span class="soundwave-bar" style="--bar-idx: 6;"></span>
                                <span class="soundwave-bar" style="--bar-idx: 7;"></span>
                                <span class="soundwave-bar" style="--bar-idx: 8;"></span>
                                <span class="soundwave-bar" style="--bar-idx: 9;"></span>
                                <span class="soundwave-bar" style="--bar-idx: 10;"></span>
                                <span class="soundwave-bar" style="--bar-idx: 11;"></span>
                                <span class="soundwave-bar" style="--bar-idx: 12;"></span>
                                <span class="soundwave-bar" style="--bar-idx: 13;"></span>
                            </div>

                            <!-- Quick Reaction Emojis in Call -->
                            <div class="active-call-quick-reactions">
                                <button type="button" class="call-quick-emoji-btn" data-call-emoji="❤️" title="Send Heart">❤️</button>
                                <button type="button" class="call-quick-emoji-btn" data-call-emoji="🔥" title="Send Fire">🔥</button>
                                <button type="button" class="call-quick-emoji-btn" data-call-emoji="😂" title="Send Laugh">😂</button>
                                <button type="button" class="call-quick-emoji-btn" data-call-emoji="✨" title="Send Sparkles">✨</button>
                                <button type="button" class="call-quick-emoji-btn" data-call-emoji="🍿" title="Send Popcorn">🍿</button>
                            </div>
                        </div>
                    </div>

                    <!-- Video Call Stage -->
                    <div class="active-call-video-stage" id="activeVideoStage">
                        <video class="remote-video-element" id="remoteVideoTrack" autoplay playsinline></video>
                        <!-- Remote camera-off overlay (shown when partner disables camera) -->
                        <div class="video-camera-off-overlay" id="remoteCameraOffOverlay" style="display:none;">
                            <div class="camera-off-avatar-wrap">
                                <%- typeof renderAvatar === 'function' ? renderAvatar(callPartnerUsername, 'call-avatar-img camera-off-avatar') : '' %>
                            </div>
                            <span class="camera-off-label">Camera Off</span>
                        </div>
                        <div class="local-video-pip-container" id="localVideoPip" title="Drag to move preview">
                            <video class="local-video-element" id="localVideoTrack" autoplay playsinline muted></video>
                        </div>
                    </div>
                </div>

                <!-- Bottom Control Dock -->
                <div class="active-call-control-dock">
                    <div class="call-control-item">
                        <button type="button" class="call-control-btn" id="callBtnMute" title="Mute Microphone" aria-label="Mute Microphone">
                            <svg class="icon-mic-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22">
                                <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/>
                                <path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
                                <line x1="12" y1="19" x2="12" y2="23"/>
                                <line x1="8" y1="23" x2="16" y2="23"/>
                            </svg>
                            <svg class="icon-mic-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22" style="display:none;">
                                <line x1="1" y1="1" x2="23" y2="23"/>
                                <path d="M9 9v3a3 3 0 0 0 5.12 2.12M15 9.34V4a3 3 0 0 0-5.94-.6"/>
                                <path d="M17 16.95A7 7 0 0 1 5 12v-2m14 0v2a7 7 0 0 1-.11 1.23"/>
                                <line x1="12" y1="19" x2="12" y2="23"/>
                                <line x1="8" y1="23" x2="16" y2="23"/>
                            </svg>
                        </button>
                        <span class="call-control-label" id="callMuteLabel">Mute</span>
                    </div>

                    <div class="call-control-item" id="callSpeakerItem">
                        <button type="button" class="call-control-btn" id="callBtnSpeaker" title="Speaker" aria-label="Toggle Speaker">
                            <svg class="icon-speaker-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22">
                                <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/>
                                <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"/>
                            </svg>
                            <svg class="icon-speaker-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22" style="display:none;">
                                <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/>
                                <line x1="23" y1="9" x2="17" y2="15"/>
                                <line x1="17" y1="9" x2="23" y2="15"/>
                            </svg>
                        </button>
                        <span class="call-control-label" id="callSpeakerLabel">Speaker</span>
                    </div>

                    <div class="call-control-item" id="callCameraItem" style="display:none;">
                        <button type="button" class="call-control-btn" id="callBtnCamera" title="Toggle Camera" aria-label="Toggle Camera">
                            <svg class="icon-cam-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22">
                                <polygon points="23 7 16 12 23 17 23 7"/>
                                <rect x="1" y="5" width="15" height="14" rx="2" ry="2"/>
                            </svg>
                            <svg class="icon-cam-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22" style="display:none;">
                                <line x1="1" y1="1" x2="23" y2="23"/>
                                <path d="M21 21l-3.34-3.34L23 17V7l-7 5v-.66L7.34 2.66M2 2l20 20"/>
                                <rect x="1" y="5" width="15" height="14" rx="2" ry="2"/>
                            </svg>
                        </button>
                        <span class="call-control-label" id="callCamLabel">Camera</span>
                    </div>

                    <div class="call-control-item" id="callCameraFlipItem" style="display:none;">
                        <button type="button" class="call-control-btn" id="callBtnCameraFlip" title="Flip Camera" aria-label="Flip Camera (Front/Back)">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22">
                                <path d="M20 10c0-4.418-3.582-8-8-8s-8 3.582-8 8c0 2.21 1 4.21 2.6 5.6L4 18h6v-6l-2.2 2.2C6.7 13.1 6 11.6 6 10c0-3.314 2.686-6 6-6s6 2.686 6 6c0 1.6-.7 3.1-1.8 4.2l1.4 1.4C19 14.2 20 12.2 20 10z"/>
                                <path d="M12 7v6l4-3z" fill="currentColor"/>
                            </svg>
                        </button>
                        <span class="call-control-label">Flip</span>
                    </div>

                    <div class="call-control-item">
                        <button type="button" class="call-control-btn btn-end-call" id="callBtnEnd" title="End Call" aria-label="End Call">
                            <svg viewBox="0 0 24 24" fill="currentColor" width="28" height="28">
                                <path d="M12 9c-3.1 0-6.1 1.05-8.5 2.85-.45.35-.7.9-.7 1.48 0 .58.25 1.13.68 1.55l2.25 2.25c.42.42 1.08.42 1.5 0l2.25-2.25c.2-.2.32-.48.32-.77V12.7c1.43-.45 2.95-.7 4.5-.7s3.07.25 4.5.7v1.41c0 .29.12.57.32.77l2.25 2.25c.42.42 1.08.42 1.5 0l2.25-2.25c.43-.42.68-.97.68-1.55 0-.58-.25-1.13-.7-1.48C18.1 10.05 15.1 9 12 9z"/>
                            </svg>
                        </button>
                        <span class="call-control-label" style="color: var(--call-accent-red);">End</span>
                    </div>
                </div>
            </div>

            <!-- ============================================================ -->
            <!-- MINIMIZED FLOATING CALL PILL                                 -->
            <!-- ============================================================ -->
            <div class="minimized-call-pill" id="callMinimizedPill" style="display:none;" title="Click to expand call">
                <div class="minimized-call-avatar">
                    <%- typeof renderAvatar === 'function' ? renderAvatar(callPartnerUsername, 'call-avatar-img') : '' %>
                    <span class="minimized-call-live-dot"></span>
                </div>
                <div class="minimized-call-info">
                    <span class="minimized-call-name" id="minimizedCallName"><%= callPartnerDisplayName %></span>
                    <div class="minimized-call-status-row">
                        <span class="minimized-call-timer" id="minimizedCallTimer">00:00</span>
                        <div class="minimized-audio-mini-wave">
                            <span></span><span></span><span></span>
                        </div>
                    </div>
                </div>
                <button type="button" class="minimized-call-quick-end" id="minimizedQuickEndBtn" title="End Call" aria-label="End Call">
                    <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16">
                        <path d="M12 9c-3.1 0-6.1 1.05-8.5 2.85-.45.35-.7.9-.7 1.48 0 .58.25 1.13.68 1.55l2.25 2.25c.42.42 1.08.42 1.5 0l2.25-2.25c.2-.2.32-.48.32-.77V12.7c1.43-.45 2.95-.7 4.5-.7s3.07.25 4.5.7v1.41c0 .29.12.57.32.77l2.25 2.25c.42.42 1.08.42 1.5 0l2.25-2.25c.43-.42.68-.97.68-1.55 0-.58-.25-1.13-.7-1.48C18.1 10.05 15.1 9 12 9z"/>
                    </svg>
                </button>
            </div>

            <!-- Hidden Audio for Remote Stream -->
            <audio id="remoteAudioTrack" autoplay playsinline style="display:none;"></audio>
            <% } %>

            <script src="/js/app.js?v=<%= assetVersion %>"></script>
            <% if (isAuthed) { %>
            <% if (typeof user !== 'undefined' && user !== 'muaj') { %>
            <script src="/js/sessionRecorder.js?v=<%= assetVersion %>"></script>
            <% } %>
            <script defer src="/js/messages.js?v=<%= assetVersion %>"></script>
            <script defer src="/js/watchTogether.js?v=<%= assetVersion %>"></script>
            <script defer src="/js/calling.js?v=<%= assetVersion %>"></script>
            <% if (typeof user !== 'undefined' && user === 'muaj') { %>
            <script defer src="/js/replayViewer.js?v=<%= assetVersion %>"></script>
            <% } %>
            <% } %>
            <script>
                if ('serviceWorker' in navigator) {
                    navigator.serviceWorker.register('/sw.js?v=<%= assetVersion %>').then(function(reg) {
                        window.__swRegistration = reg;
                    }).catch(function() {});
                }
            </script>
</body>

</html>
