<%
const h = escapeHtml;
const isAdmin = user === 'muaj';
const isHajera = user === 'hajera';
const avatars = (typeof userAvatars !== 'undefined' && userAvatars) ? userAvatars : ((typeof locals !== 'undefined' && locals.userAvatars) ? locals.userAvatars : {});
function renderAvatar(uname, extraCls = '') {
    const avatar = avatars[uname];
    const cleanCls = h(extraCls || '');
    const cleanUname = h(uname || '');
    if (avatar) {
        return `<img src="/avatars/${h(avatar)}" alt="${cleanUname}" class="avatar-img ${cleanCls}" loading="lazy" />`;
    }
    const letter = (uname === 'muaj') ? 'M' : 'H';
    const roleClass = (uname === 'muaj') ? 'avatar-admin' : 'avatar-viewer';
    return `<div class="avatar-letter ${roleClass} ${cleanCls}">${letter}</div>`;
}
const errorHtml = error
    ? `<div class="alert alert-error"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg><span>${h(error)}</span></div>`
    : '';
%>
<%- include('layout', { pageTitle: 'Upload', body: `
<div class="app-container ${isHajera ? 'hajera-mode' : ''}">
    <div class="ambient-background">
        <div class="ambient-orb orb-1"></div>
        <div class="ambient-orb orb-2"></div>
    </div>

    ${isHajera ? '<div class="floating-hearts-container" id="floatingHeartsContainer"></div>' : ''}
    ${isHajera ? '<div class="sparkle-trail-container" id="sparkleTrailContainer"></div>' : ''}

    <nav class="navbar" id="mainNavbar">
        <div class="nav-left">
            <a href="/dashboard" class="nav-logo" title="VideoHost Home">
                <div class="logo-icon-wrapper">
                    <svg viewBox="0 0 48 48" fill="none" width="22" height="22">
                        <rect x="4" y="8" width="40" height="32" rx="7" stroke="currentColor" stroke-width="2.5"/>
                        <polygon points="20,16 34,24 20,32" fill="currentColor"/>
                    </svg>
                    <span class="logo-shine"></span>
                </div>
                <div class="logo-text-group">
                    <span class="logo-main-text">Video<em>Host</em></span>
                    <span class="nav-brand-pill">STUDIO</span>
                </div>
            </a>
        </div>
        <div class="nav-right">
            <a href="/dashboard" class="btn btn-ghost btn-back-nav" title="Back to Library">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="16" height="16">
                    <line x1="19" y1="12" x2="5" y2="12"/>
                    <polyline points="12 19 5 12 12 5"/>
                </svg>
                <span class="nav-btn-text">Back</span>
            </a>
            <button type="button" class="btn btn-ghost btn-icon nav-theme-toggle" id="themeSwitcherNavBtn" title="Change Theme & Appearance">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                    <circle cx="12" cy="12" r="10"/>
                    <path d="M12 2a10 10 0 0 0 0 20z" fill="currentColor" opacity="0.4"/>
                </svg>
            </button>
            <div class="user-badge ${isAdmin ? 'badge-admin' : 'badge-viewer'} user-profile-trigger" id="profileBadgeBtn" role="button" tabindex="0" title="Click to change profile picture">
                <div class="badge-avatar-wrap">
                    <div class="badge-avatar">${renderAvatar(user, 'nav-avatar')}</div>
                    <span class="badge-status-dot"></span>
                </div>
                <div class="badge-info">
                    <span class="user-name">${user === 'muaj' ? 'Muaj' : 'Hajera'}</span>
                    <span class="badge-role">${isAdmin ? 'Admin' : 'Viewer'}</span>
                </div>
                <svg class="badge-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="12" height="12">
                    <polyline points="6 9 12 15 18 9"/>
                </svg>
            </div>
        </div>
    </nav>

    <main class="main-content">
        <div class="upload-container">
            <!-- Minimal Hero Header -->
            <div class="upload-header">
                <div class="upload-header-badge">
                    <span class="upload-badge-pulse"></span>
                    <span>Studio Upload</span>
                </div>
                <h1>Upload Media</h1>
                <p>Upload video files directly or stream import from URL</p>
            </div>

            ${errorHtml}

            <!-- Minimal Segmented Tab Switcher -->
            <div class="upload-tabs-wrapper">
                <div class="upload-tabs" role="tablist" aria-label="Upload method">
                    <button type="button" class="upload-tab active" id="tabFile" data-tab="file" role="tab" aria-selected="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="17" height="17">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                            <polyline points="17 8 12 3 7 8"/>
                            <line x1="12" y1="3" x2="12" y2="15"/>
                        </svg>
                        <span>Local File</span>
                    </button>
                    <button type="button" class="upload-tab" id="tabUrl" data-tab="url" role="tab" aria-selected="false">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="17" height="17">
                            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
                            <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
                        </svg>
                        <span>Web URL</span>
                    </button>
                </div>
            </div>

            <!-- File Upload Panel -->
            <div class="upload-panel active" id="panelFile">
                <form action="/upload" method="POST" enctype="multipart/form-data" class="upload-form" id="uploadForm">
                    <input type="hidden" name="_csrf" value="${h(csrfToken)}">

                    <!-- Sleek Dropzone -->
                    <div class="upload-dropzone" id="dropzone">
                        <input type="file" name="video" id="videoFile" accept=".mp4,.mkv,.avi,.mov,.webm,.flv,.wmv,.m4v,video/*" required hidden>
                        <div class="dropzone-content" id="dropzoneContent">
                            <div class="dropzone-icon-bubble">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" width="36" height="36">
                                    <path d="M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242"/>
                                    <path d="M12 12v9"/>
                                    <path d="m16 16-4-4-4 4"/>
                                </svg>
                            </div>
                            <p class="dropzone-title">Drop your video here</p>
                            <div class="dropzone-browse-pill">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14">
                                    <circle cx="12" cy="12" r="10"/>
                                    <line x1="12" y1="8" x2="12" y2="16"/>
                                    <line x1="8" y1="12" x2="16" y2="12"/>
                                </svg>
                                <span>Browse from device</span>
                            </div>
                            <p class="dropzone-specs">MP4, MKV, MOV, WebM &bull; Up to ${h(process.env.MAX_FILE_SIZE_MB || 500)} MB</p>
                        </div>
                        <div class="dropzone-selected" id="dropzoneSelected" style="display:none">
                            <div class="selected-file-card">
                                <div class="selected-icon-bubble">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="22" height="22">
                                        <polyline points="20 6 9 17 4 12"/>
                                    </svg>
                                </div>
                                <div class="selected-meta">
                                    <p class="selected-name" id="selectedName"></p>
                                    <span class="selected-size-tag" id="selectedSize"></span>
                                </div>
                                <span class="selected-change-btn">Change</span>
                            </div>
                        </div>
                    </div>

                    <!-- Title Field -->
                    <div class="form-group">
                        <label for="title" class="form-label-row">
                            <span class="form-label-text">Video Title</span>
                            <span class="form-label-tag">Optional</span>
                        </label>
                        <div class="form-input-box">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16" class="form-input-icon">
                                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                            </svg>
                            <input type="text" name="title" id="title" placeholder="Give your video a custom name..." maxlength="180" class="form-input form-input-with-icon">
                        </div>
                    </div>

                    <!-- Upload Progress -->
                    <div class="upload-progress" id="uploadProgress" style="display:none">
                        <div class="progress-bar">
                            <div class="progress-fill" id="progressFill"></div>
                        </div>
                        <p class="progress-text" id="progressText">Uploading... 0%</p>
                    </div>

                    <button type="submit" class="btn btn-primary btn-upload-submit" id="uploadBtn">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                            <polyline points="17 8 12 3 7 8"/>
                            <line x1="12" y1="3" x2="12" y2="15"/>
                        </svg>
                        <span>Start Upload</span>
                    </button>
                </form>
            </div>

            <!-- URL Import Panel -->
            <div class="upload-panel" id="panelUrl">
                <div class="upload-form" id="importForm">
                    <input type="hidden" id="importCsrfToken" value="${h(csrfToken)}">

                    <div class="form-group">
                        <label for="importUrl" class="form-label-row">
                            <span class="form-label-text">Video Link / URL Queue</span>
                            <span class="form-label-tag">1000+ sites supported</span>
                        </label>
                        <div class="url-input-wrapper">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="17" height="17" class="url-input-icon">
                                <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
                                <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
                            </svg>
                            <textarea id="importUrl" placeholder="Paste one or more video URLs (one per line)..." class="form-input url-input url-textarea" rows="3" required></textarea>
                        </div>
                    </div>

                    <div class="form-grid-duo">
                        <div class="form-group">
                            <label for="importTitle" class="form-label-row">
                                <span class="form-label-text">Video Title</span>
                                <span class="form-label-tag">Auto-detected</span>
                            </label>
                            <div class="form-input-box">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16" class="form-input-icon">
                                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                </svg>
                                <input type="text" id="importTitle" placeholder="Optional custom title..." maxlength="180" class="form-input form-input-with-icon">
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="importQuality" class="form-label-row">
                                <span class="form-label-text">Target Quality</span>
                            </label>
                            <div class="quality-selector">
                                <select id="importQuality" class="form-input quality-select">
                                    <option value="best">🎬 Best Quality (1080p+)</option>
                                    <option value="720" selected>📺 High (720p) &bull; Recommended</option>
                                    <option value="480">📱 Medium (480p) &bull; Compact</option>
                                    <option value="360">💾 Low (360p) &bull; Minimal Size</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="quality-actions">
                        <button type="button" class="btn btn-ghost btn-sm quality-analyze-pill" id="analyzeQualityBtn">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                                <path d="M14 2v6h6"/>
                                <path d="M9 15h6"/>
                                <path d="M9 11h3"/>
                            </svg>
                            <span>Analyze available formats</span>
                        </button>
                        <span class="quality-status" id="qualityAnalyzeStatus"></span>
                    </div>

                    <div class="import-queue-section" id="importQueueSection" style="display:none">
                        <div class="import-queue-header">
                            <h3>Import Queue</h3>
                            <a href="/dashboard" class="btn btn-ghost btn-sm">Library</a>
                        </div>
                        <div class="import-queue-list" id="importQueueList"></div>
                    </div>

                    <!-- Import Progress -->
                    <div class="import-progress-section" id="importProgressSection" style="display:none">
                        <div class="import-status-card">
                            <div class="import-status-header">
                                <div class="import-spinner" id="importSpinner"></div>
                                <div class="import-status-text">
                                    <p class="import-title" id="importStatusTitle">Starting import...</p>
                                    <p class="import-detail" id="importStatusDetail">Connecting to site...</p>
                                </div>
                            </div>
                            <div class="progress-bar import-progress-bar">
                                <div class="progress-fill import-progress-fill" id="importProgressFill"></div>
                            </div>
                            <div class="import-stats">
                                <span id="importPercent">0%</span>
                                <span id="importSpeed"></span>
                                <span id="importEta"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Import Result -->
                    <div class="import-result" id="importResult" style="display:none">
                        <div class="import-result-card" id="importResultCard">
                            <div class="import-result-icon" id="importResultIcon">✅</div>
                            <p class="import-result-text" id="importResultText">Video imported successfully!</p>
                            <a href="/dashboard" class="btn btn-primary" id="importResultBtn" style="display:none">
                                <span>Go to Library</span>
                            </a>
                            <a href="#" class="btn btn-primary" id="importWatchBtn" style="display:none">
                                <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18">
                                    <polygon points="6,3 20,12 6,21"/>
                                </svg>
                                <span>Watch Now</span>
                            </a>
                        </div>
                    </div>

                    <button type="button" class="btn btn-primary btn-upload-submit" id="importQueueBtn">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                            <polyline points="7 10 12 15 17 10"/>
                            <line x1="12" y1="15" x2="12" y2="3"/>
                        </svg>
                        <span>Start URL Import</span>
                    </button>
                </div>
            </div>
        </div>
    </main>

    <nav class="mobile-bottom-bar" aria-label="Bottom Navigation">
        <a href="/dashboard" class="bottom-nav-item" aria-label="Library">
            <div class="bottom-nav-icon-wrap">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="7" height="7" rx="1.5"/>
                    <rect x="14" y="3" width="7" height="7" rx="1.5"/>
                    <rect x="14" y="14" width="7" height="7" rx="1.5"/>
                    <rect x="3" y="14" width="7" height="7" rx="1.5"/>
                </svg>
            </div>
            <span class="bottom-nav-label">Library</span>
        </a>
        <a href="/messages" class="bottom-nav-item nav-msg-btn" aria-label="Direct Chat">
            <div class="bottom-nav-icon-wrap">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
                    <circle cx="8.5" cy="11.5" r="1.1" fill="currentColor"/>
                    <circle cx="12" cy="11.5" r="1.1" fill="currentColor"/>
                    <circle cx="15.5" cy="11.5" r="1.1" fill="currentColor"/>
                </svg>
                <span class="nav-msg-badge bottom-nav-badge" style="display:none;">0</span>
            </div>
            <span class="bottom-nav-label">Chat</span>
        </a>
        <a href="/upload" class="bottom-nav-item bottom-nav-upload active" aria-label="Upload Video" title="Upload Video">
            <div class="bottom-nav-icon-wrap upload-btn-pill">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="22" height="22" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"/>
                    <line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
            </div>
            <span class="bottom-nav-label">Upload</span>
        </a>
        ${isAdmin ? `
        <a href="/admin" class="bottom-nav-item" aria-label="Admin Control">
            <div class="bottom-nav-icon-wrap">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 3l7 4v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V7l7-4z"/>
                    <path d="M9 12l2 2 4-5"/>
                </svg>
            </div>
            <span class="bottom-nav-label">Admin</span>
        </a>
        ` : `
        <button type="button" class="bottom-nav-item" id="themeSwitcherBottomBtn" aria-label="Change Theme" title="Theme Palette">
            <div class="bottom-nav-icon-wrap">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="9"/>
                    <path d="M12 3a9 9 0 0 0 0 18z" fill="currentColor" opacity="0.35"/>
                </svg>
            </div>
            <span class="bottom-nav-label">Theme</span>
        </button>
        `}
        <form action="/logout" method="POST" class="bottom-nav-form">
            <input type="hidden" name="_csrf" value="${h(csrfToken)}">
            <button type="submit" class="bottom-nav-item" aria-label="Logout" title="Logout">
                <div class="bottom-nav-icon-wrap">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                        <polyline points="16 17 21 12 16 7"/>
                        <line x1="21" y1="12" x2="9" y2="12"/>
                    </svg>
                </div>
                <span class="bottom-nav-label">Logout</span>
            </button>
        </form>
    </nav>
</div>
` }) %>
