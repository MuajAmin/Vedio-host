<%
const h = escapeHtml;
const isAdmin = user === 'muaj';
const isHajera = user === 'hajera';
const errorHtml = error
    ? `<div class="alert alert-error"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg><span>${h(error)}</span></div>`
    : '';
%>
<%- include('layout', { pageTitle: 'Upload', body: `
<div class="app-container ${isHajera ? 'hajera-mode' : ''}">
    <div class="ambient-background">
        <div class="ambient-orb orb-1"></div>
        <div class="ambient-orb orb-2"></div>
    </div>

    ${isHajera ? '<div class="floating-hearts-container" id="floatingHeartsContainer"></div>' : ''}
    ${isHajera ? '<div class="sparkle-trail-container" id="sparkleTrailContainer"></div>' : ''}

    <nav class="navbar">
        <div class="nav-left">
            <a href="/dashboard" class="nav-logo">
                <div class="logo-icon-wrapper">
                    <svg viewBox="0 0 48 48" fill="none" width="24" height="24">
                        <rect x="4" y="8" width="40" height="32" rx="6" stroke="currentColor" stroke-width="2.5"/>
                        <polygon points="20,16 34,24 20,32" fill="currentColor"/>
                    </svg>
                </div>
                <span>Video<em>Host</em></span>
            </a>
        </div>
        <div class="nav-right">
            <a href="/dashboard" class="btn btn-ghost">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                    <line x1="19" y1="12" x2="5" y2="12"/>
                    <polyline points="12 19 5 12 12 5"/>
                </svg>
                <span>Back</span>
            </a>
        </div>
    </nav>

    <main class="main-content">
        <div class="upload-container">
            <div class="upload-header">
                <h1>Add Video</h1>
                <p>Upload a file or import from URL</p>
            </div>

            ${errorHtml}

            <!-- Tab Switcher -->
            <div class="upload-tabs">
                <button type="button" class="upload-tab active" id="tabFile" data-tab="file">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                        <polyline points="17 8 12 3 7 8"/>
                        <line x1="12" y1="3" x2="12" y2="15"/>
                    </svg>
                    <span>File Upload</span>
                </button>
                <button type="button" class="upload-tab" id="tabUrl" data-tab="url">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                        <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
                        <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
                    </svg>
                    <span>Import from URL</span>
                </button>
            </div>

            <!-- File Upload Panel -->
            <div class="upload-panel active" id="panelFile">
                <form action="/upload" method="POST" enctype="multipart/form-data" class="upload-form" id="uploadForm">
                    <input type="hidden" name="_csrf" value="${h(csrfToken)}">
                    <div class="form-group">
                        <label for="title">Video Title</label>
                        <input type="text" name="title" id="title" placeholder="Video name..." maxlength="180" class="form-input">
                    </div>

                    <div class="upload-dropzone" id="dropzone">
                        <input type="file" name="video" id="videoFile" accept=".mp4,.mkv,.avi,.mov,.webm,.flv,.wmv,.m4v,video/*" required hidden>
                        <div class="dropzone-content" id="dropzoneContent">
                            <div class="dropzone-icon">
                                <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.5" width="64" height="64">
                                    <path d="M40 42V46C40 48.2091 38.2091 50 36 50H12C9.79086 50 8 48.2091 8 46V22C8 19.7909 9.79086 18 12 18H16"/>
                                    <rect x="24" y="14" width="32" height="28" rx="2"/>
                                    <polyline points="40 22 40 28"/>
                                    <polyline points="37 25 40 22 43 25"/>
                                </svg>
                            </div>
                            <p class="dropzone-text">Drop video here</p>
                            <p class="dropzone-subtext">or tap to choose file</p>
                            <p class="dropzone-formats">MP4, MKV, AVI, MOV, WebM - Max ${h(process.env.MAX_FILE_SIZE_MB || 500)}MB</p>
                        </div>
                        <div class="dropzone-selected" id="dropzoneSelected" style="display:none">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="32" height="32">
                                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                                <polyline points="22 4 12 14.01 9 11.01"/>
                            </svg>
                            <p class="selected-name" id="selectedName"></p>
                            <p class="selected-size" id="selectedSize"></p>
                        </div>
                    </div>

                    <div class="upload-progress" id="uploadProgress" style="display:none">
                        <div class="progress-bar">
                            <div class="progress-fill" id="progressFill"></div>
                        </div>
                        <p class="progress-text" id="progressText">Uploading... 0%</p>
                    </div>

                    <button type="submit" class="btn btn-primary btn-upload-submit" id="uploadBtn">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                            <polyline points="17 8 12 3 7 8"/>
                            <line x1="12" y1="3" x2="12" y2="15"/>
                        </svg>
                        <span>Upload</span>
                    </button>
                </form>
            </div>

            <!-- URL Import Panel -->
            <div class="upload-panel" id="panelUrl">
                <div class="upload-form" id="importForm">
                    <input type="hidden" id="importCsrfToken" value="${h(csrfToken)}">
                    <div class="form-group">
                        <label for="importTitle">Video Title <span class="label-hint">(optional — auto-detected from URL)</span></label>
                        <input type="text" id="importTitle" placeholder="Leave empty to auto-detect title..." maxlength="180" class="form-input">
                    </div>

                    <div class="form-group">
                        <label for="importUrl">Video URL Queue</label>
                        <div class="url-input-wrapper">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18" class="url-input-icon">
                                <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
                                <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
                            </svg>
                            <textarea id="importUrl" placeholder="Paste one video URL per line..." class="form-input url-input url-textarea" rows="4" required></textarea>
                        </div>
                        <p class="form-hint">Supports 1000+ sites — paste any video page URL</p>
                    </div>

                    <div class="form-group">
                        <label for="importQuality">Video Quality</label>
                        <div class="quality-selector">
                            <select id="importQuality" class="form-input quality-select">
                                <option value="best">🎬 Best Quality (1080p+)</option>
                                <option value="720" selected>📺 High (720p) — Recommended</option>
                                <option value="480">📱 Medium (480p) — Saves Space</option>
                                <option value="360">💾 Low (360p) — Minimum Size</option>
                            </select>
                        </div>
                        <p class="form-hint">Lower quality = faster download, less storage used</p>
                    </div>

                    <div class="quality-actions">
                        <button type="button" class="btn btn-ghost btn-sm" id="analyzeQualityBtn">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                                <path d="M14 2v6h6"/>
                                <path d="M9 15h6"/>
                                <path d="M9 11h3"/>
                            </svg>
                            <span>Analyze qualities</span>
                        </button>
                        <span class="quality-status" id="qualityAnalyzeStatus"></span>
                    </div>

                    <div class="import-queue-section" id="importQueueSection" style="display:none">
                        <div class="import-queue-header">
                            <h3>Import Queue</h3>
                            <a href="/dashboard" class="btn btn-ghost btn-sm">Library</a>
                        </div>
                        <div class="import-queue-list" id="importQueueList"></div>
                    </div>

                    <!-- Import Progress -->
                    <div class="import-progress-section" id="importProgressSection" style="display:none">
                        <div class="import-status-card">
                            <div class="import-status-header">
                                <div class="import-spinner" id="importSpinner"></div>
                                <div class="import-status-text">
                                    <p class="import-title" id="importStatusTitle">Starting import...</p>
                                    <p class="import-detail" id="importStatusDetail">Connecting to site...</p>
                                </div>
                            </div>
                            <div class="progress-bar import-progress-bar">
                                <div class="progress-fill import-progress-fill" id="importProgressFill"></div>
                            </div>
                            <div class="import-stats">
                                <span id="importPercent">0%</span>
                                <span id="importSpeed"></span>
                                <span id="importEta"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Import Result -->
                    <div class="import-result" id="importResult" style="display:none">
                        <div class="import-result-card" id="importResultCard">
                            <div class="import-result-icon" id="importResultIcon">✅</div>
                            <p class="import-result-text" id="importResultText">Video imported successfully!</p>
                            <a href="/dashboard" class="btn btn-primary" id="importResultBtn" style="display:none">
                                <span>Go to Library</span>
                            </a>
                            <a href="#" class="btn btn-primary" id="importWatchBtn" style="display:none">
                                <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18">
                                    <polygon points="6,3 20,12 6,21"/>
                                </svg>
                                <span>Watch Now</span>
                            </a>
                        </div>
                    </div>

                    <button type="button" class="btn btn-primary btn-upload-submit" id="importQueueBtn">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                            <polyline points="7 10 12 15 17 10"/>
                            <line x1="12" y1="15" x2="12" y2="3"/>
                        </svg>
                        <span>Import Video</span>
                    </button>
                </div>
            </div>
        </div>
    </main>

    <nav class="mobile-bottom-bar">
        <a href="/dashboard" class="bottom-nav-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22">
                <rect x="3" y="3" width="7" height="7" rx="1.5"/>
                <rect x="14" y="3" width="7" height="7" rx="1.5"/>
                <rect x="14" y="14" width="7" height="7" rx="1.5"/>
                <rect x="3" y="14" width="7" height="7" rx="1.5"/>
            </svg>
            <span>Library</span>
        </a>
        <a href="/upload" class="bottom-nav-item active bottom-nav-upload">
            <div class="upload-fab">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="22" height="22">
                    <line x1="12" y1="5" x2="12" y2="19"/>
                    <line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
            </div>
            <span>Upload</span>
        </a>
        <form action="/logout" method="POST" class="bottom-nav-form">
            <input type="hidden" name="_csrf" value="${h(csrfToken)}">
            <button type="submit" class="bottom-nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                    <polyline points="16 17 21 12 16 7"/>
                    <line x1="21" y1="12" x2="9" y2="12"/>
                </svg>
                <span>Logout</span>
            </button>
        </form>
    </nav>
</div>
` }) %>
