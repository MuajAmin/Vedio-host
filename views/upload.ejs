<%
const h = escapeHtml;
const errorHtml = error
    ? `<div class="alert alert-error"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg><span>${h(error)}</span></div>`
    : '';
%>
<%- include('layout', { pageTitle: 'Upload', body: `
<div class="app-container">
    <div class="ambient-background">
        <div class="ambient-orb orb-1"></div>
        <div class="ambient-orb orb-2"></div>
        <div class="ambient-orb orb-3"></div>
    </div>

    <nav class="navbar">
        <div class="nav-left">
            <a href="/dashboard" class="nav-logo">
                <div class="logo-icon-wrapper">
                    <svg viewBox="0 0 48 48" fill="none" width="24" height="24">
                        <rect x="4" y="8" width="40" height="32" rx="6" stroke="currentColor" stroke-width="2.5"/>
                        <polygon points="20,16 34,24 20,32" fill="currentColor"/>
                    </svg>
                </div>
                <span>Video<em>Host</em></span>
            </a>
        </div>
        <div class="nav-right">
            <a href="/dashboard" class="btn btn-ghost">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                    <line x1="19" y1="12" x2="5" y2="12"/>
                    <polyline points="12 19 5 12 12 5"/>
                </svg>
                <span>Back</span>
            </a>
        </div>
    </nav>

    <main class="main-content">
        <div class="upload-container">
            <div class="upload-header">
                <h1>Video Upload</h1>
                <p>Add a new video to the private collection</p>
            </div>

            ${errorHtml}

            <form action="/upload" method="POST" enctype="multipart/form-data" class="upload-form" id="uploadForm">
                <input type="hidden" name="_csrf" value="${h(csrfToken)}">
                <div class="form-group">
                    <label for="title">Video Title</label>
                    <input type="text" name="title" id="title" placeholder="Video name..." maxlength="180" class="form-input">
                </div>

                <div class="upload-dropzone" id="dropzone">
                    <input type="file" name="video" id="videoFile" accept=".mp4,.mkv,.avi,.mov,.webm,.flv,.wmv,.m4v,video/*" required hidden>
                    <div class="dropzone-content" id="dropzoneContent">
                        <div class="dropzone-icon">
                            <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.5" width="64" height="64">
                                <path d="M40 42V46C40 48.2091 38.2091 50 36 50H12C9.79086 50 8 48.2091 8 46V22C8 19.7909 9.79086 18 12 18H16"/>
                                <rect x="24" y="14" width="32" height="28" rx="2"/>
                                <polyline points="40 22 40 28"/>
                                <polyline points="37 25 40 22 43 25"/>
                            </svg>
                        </div>
                        <p class="dropzone-text">Drop video here</p>
                        <p class="dropzone-subtext">or tap to choose file</p>
                        <p class="dropzone-formats">MP4, MKV, AVI, MOV, WebM - Max ${h(process.env.MAX_FILE_SIZE_MB || 500)}MB</p>
                    </div>
                    <div class="dropzone-selected" id="dropzoneSelected" style="display:none">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="32" height="32">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                            <polyline points="22 4 12 14.01 9 11.01"/>
                        </svg>
                        <p class="selected-name" id="selectedName"></p>
                        <p class="selected-size" id="selectedSize"></p>
                    </div>
                </div>

                <div class="upload-progress" id="uploadProgress" style="display:none">
                    <div class="progress-bar">
                        <div class="progress-fill" id="progressFill"></div>
                    </div>
                    <p class="progress-text" id="progressText">Uploading... 0%</p>
                </div>

                <button type="submit" class="btn btn-primary btn-upload-submit" id="uploadBtn">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                        <polyline points="17 8 12 3 7 8"/>
                        <line x1="12" y1="3" x2="12" y2="15"/>
                    </svg>
                    <span>Upload</span>
                </button>
            </form>
        </div>
    </main>

    <nav class="mobile-bottom-bar">
        <a href="/dashboard" class="bottom-nav-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22">
                <rect x="3" y="3" width="7" height="7" rx="1.5"/>
                <rect x="14" y="3" width="7" height="7" rx="1.5"/>
                <rect x="14" y="14" width="7" height="7" rx="1.5"/>
                <rect x="3" y="14" width="7" height="7" rx="1.5"/>
            </svg>
            <span>Library</span>
        </a>
        <a href="/upload" class="bottom-nav-item active bottom-nav-upload">
            <div class="upload-fab">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="22" height="22">
                    <line x1="12" y1="5" x2="12" y2="19"/>
                    <line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
            </div>
            <span>Upload</span>
        </a>
        <form action="/logout" method="POST" class="bottom-nav-form">
            <input type="hidden" name="_csrf" value="${h(csrfToken)}">
            <button type="submit" class="bottom-nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                    <polyline points="16 17 21 12 16 7"/>
                    <line x1="21" y1="12" x2="9" y2="12"/>
                </svg>
                <span>Logout</span>
            </button>
        </form>
    </nav>
</div>
` }) %>
