<%
const h = typeof escapeHtml === 'function' ? escapeHtml : (str => String(str || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;'));
const currentPartner = typeof partner !== 'undefined' && partner ? partner : 'hajera';
const partnerName = currentPartner === 'muaj' ? 'Muaj' : 'Hajera';
const partnerRole = currentPartner === 'muaj' ? 'Admin' : 'Viewer';
const partnerRoleClass = currentPartner === 'muaj' ? 'tag-admin' : 'tag-viewer';
const presence = (typeof partnerPresence !== 'undefined' && partnerPresence) ? partnerPresence : { status: 'offline', isOnline: false, isWatching: false, isIdle: false };
const isOnline = presence.isOnline || presence.isWatching;
const isWatching = presence.isWatching;
const isIdle = presence.isIdle;
const statusClass = isWatching ? 'dot-watching' : (isOnline ? 'dot-online' : (isIdle ? 'dot-idle' : 'dot-offline'));
const msgStats = (typeof stats !== 'undefined' && stats) ? stats : {};
const msgList = (typeof initialMessages !== 'undefined' && Array.isArray(initialMessages)) ? initialMessages : [];
const videoList = (typeof videos !== 'undefined' && Array.isArray(videos)) ? videos : [];

let presenceText = '⚫ Offline';
if (isWatching && presence.videoTitle) {
    presenceText = `<span class="watching-highlight">🎬 Watching:</span> ${h(presence.videoTitle)}`;
} else if (isOnline) {
    presenceText = '🟢 Active Now';
} else if (isIdle) {
    presenceText = '🟡 Away';
}

const _fmtDhakaTime = new Intl.DateTimeFormat('en-US', {
    timeZone: 'Asia/Dhaka',
    hour: 'numeric',
    minute: '2-digit',
    hour12: true
});

const _fmtDhakaDateParts = new Intl.DateTimeFormat('en-US', {
    timeZone: 'Asia/Dhaka',
    year: 'numeric',
    month: 'numeric',
    day: 'numeric'
});

const _fmtDhakaHeaderMonthDay = new Intl.DateTimeFormat('en-US', {
    timeZone: 'Asia/Dhaka',
    month: 'short',
    day: 'numeric'
});

const _fmtDhakaHeaderYear = new Intl.DateTimeFormat('en-US', {
    timeZone: 'Asia/Dhaka',
    month: 'short',
    day: 'numeric',
    year: 'numeric'
});

function formatTime(isoStr) {
    if (!isoStr) return '';
    try {
        const d = new Date(isoStr);
        if (isNaN(d.getTime())) return '';
        return _fmtDhakaTime.format(d);
    } catch {
        return '';
    }
}

function getDhakaDateParts(date) {
    return _fmtDhakaDateParts.format(date);
}

const _nowForHeader = new Date();
const _todayDateStr = _fmtDhakaDateParts.format(_nowForHeader);
const _yesterdayDateStr = _fmtDhakaDateParts.format(new Date(_nowForHeader.getTime() - 86400000));
const _currentYearNum = _nowForHeader.getFullYear();

function formatDateHeader(isoStr) {
    if (!isoStr) return '';
    try {
        const d = new Date(isoStr);
        if (isNaN(d.getTime())) return '';
        const msgDateStr = _fmtDhakaDateParts.format(d);
        if (msgDateStr === _todayDateStr) return 'Today';
        if (msgDateStr === _yesterdayDateStr) return 'Yesterday';
        return d.getFullYear() !== _currentYearNum
            ? _fmtDhakaHeaderYear.format(d)
            : _fmtDhakaHeaderMonthDay.format(d);
    } catch {
        return '';
    }
}

function getEmojiStats(rawText) {
    if (!rawText || typeof rawText !== 'string') return { isEmojiOnly: false, count: 0 };
    const trimmed = rawText.trim();
    if (!trimmed) return { isEmojiOnly: false, count: 0 };
    const emojiRegex = /(?:\p{Extended_Pictographic}|\p{Emoji_Presentation}|\p{Emoji}\uFE0F|[\u{1F1E6}-\u{1F1FF}]|[\u{1F3FB}-\u{1F3FF}])/gu;
    const cleanTextWithoutEmoji = trimmed.replace(emojiRegex, '').replace(/[\s\r\n\u200D\uFE0E\uFE0F\u200B\uFEFF]/g, '');
    if (cleanTextWithoutEmoji.length > 0) {
        return { isEmojiOnly: false, count: 0 };
    }
    const matches = trimmed.match(emojiRegex) || [];
    return {
        isEmojiOnly: matches.length > 0 && matches.length <= 8,
        count: matches.length
    };
}

function renderReactionsHtml(reactions, currentU) {
    if (!reactions || !Array.isArray(reactions) || reactions.length === 0) return '';
    const grouped = {};
    reactions.forEach(r => {
        if (!grouped[r.reaction]) grouped[r.reaction] = [];
        grouped[r.reaction].push(r.user);
    });

    const badges = Object.keys(grouped).map(emoji => {
        const users = grouped[emoji];
        const isMine = users.includes(currentU);
        return `
            <button type="button" class="msg-reaction-badge ${isMine ? 'is-user-reacted' : ''}" data-emoji="${h(emoji)}" title="${h(users.join(', '))}">
                <span>${h(emoji)}</span>
                <span>${users.length}</span>
            </button>
        `;
    }).join('');

    return `<div class="msg-reactions-row">${badges}</div>`;
}

function renderReplyQuoteHtml(replyTo, currentU) {
    if (!replyTo) return '';
    const isReplyToMe = replyTo.sender === currentU;
    const authorName = isReplyToMe ? 'You' : (replyTo.sender === 'muaj' ? 'Muaj' : (replyTo.sender === 'hajera' ? 'Hajera' : (replyTo.sender || 'Unknown')));

    let contentSnippet = '';
    let mediaThumbHtml = '';

    if (replyTo.isDeleted) {
        contentSnippet = '<span class="msg-quote-deleted">⚠️ Original message was deleted</span>';
    } else {
        if (replyTo.text) {
            contentSnippet = `<span class="msg-quote-text">${h(replyTo.text)}</span>`;
        }
        if (replyTo.videoTitle || replyTo.videoId) {
            const vTitle = replyTo.videoTitle || 'Shared Video';
            const thumbUrl = replyTo.videoThumbnail ? `/thumbnails/${encodeURIComponent(replyTo.videoThumbnail)}` : '';
            contentSnippet = `<span class="msg-quote-media-indicator">🎬 ${h(vTitle)}</span>` + (contentSnippet ? ` — ${contentSnippet}` : '');
            if (thumbUrl) {
                mediaThumbHtml = `<img src="${thumbUrl}" class="msg-quote-thumb" alt="" />`;
            }
        } else if (replyTo.voiceUrl) {
            contentSnippet = `<span class="msg-quote-media-indicator">🎙️ Voice Note</span>` + (contentSnippet ? ` — ${contentSnippet}` : '');
        }
    }

    return `
        <div class="msg-quote-card ${isReplyToMe ? 'is-reply-to-me' : 'is-reply-to-partner'}" data-reply-id="${replyTo.id || ''}" title="Click to jump to original message">
            <div class="msg-quote-bar"></div>
            <div class="msg-quote-content">
                <div class="msg-quote-author">
                    <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 17 4 12 9 7"/><path d="M20 18v-2a4 4 0 0 0-4-4H4"/></svg>
                    <span>${h(authorName)}</span>
                </div>
                <div class="msg-quote-snippet">${contentSnippet}</div>
            </div>
            ${mediaThumbHtml}
        </div>
    `;
}

const currentUser = typeof user !== 'undefined' && user ? user : 'user';

let lastDate = '';
let messagesListHtml = '';

if (msgList.length === 0) {
    messagesListHtml = `
        <div class="msg-empty-state">
            <div class="msg-empty-icon-wrap">✨</div>
            <h3 class="msg-empty-title">Your Private Lounge</h3>
            <p class="msg-empty-desc">Send a message, share a video clip, or record a voice note for ${h(partnerName)}.</p>
            <div class="msg-empty-starters">
                <button type="button" class="msg-empty-starter-chip" data-starter="hello">👋 Say Hello</button>
                <button type="button" class="msg-empty-starter-chip" data-starter="movie">🍿 Watch a Movie?</button>
                <button type="button" class="msg-empty-starter-chip" data-starter="voice">🎙️ Voice Note</button>
            </div>
        </div>
    `;
} else {
    messagesListHtml = msgList.map(msg => {
        const isOut = msg.sender === currentUser;
        const rowClass = isOut ? 'msg-row-outgoing' : 'msg-row-incoming';
        const timeStr = formatTime(msg.createdAt);
        const dateStr = formatDateHeader(msg.createdAt);
        const seenHtml = isOut
            ? `<span class="msg-seen-check ${msg.isRead ? 'is-seen' : ''}" title="${msg.isRead ? 'Seen' : 'Sent'}">${msg.isRead ? '✓✓' : '✓'}</span>`
            : '';

        let dateDivider = '';
        if (dateStr && dateStr !== lastDate) {
            lastDate = dateStr;
            dateDivider = `<div class="msg-date-divider" data-date="${h(dateStr)}"><span>${h(dateStr)}</span></div>`;
        }

        let videoCardHtml = '';
        if (msg.video) {
            const thumbUrl = msg.video.thumbnail ? `/thumbnails/${encodeURIComponent(msg.video.thumbnail)}` : '';
            videoCardHtml = `
                <div class="msg-video-card" data-video-id="${h(msg.video.id)}">
                    <div class="msg-video-card-thumb-wrap">
                        ${thumbUrl ? `<img src="${thumbUrl}" class="msg-video-card-thumb-img" alt="" loading="lazy" />` : '<div class="thumb-fallback">🎬</div>'}
                        <a href="/watch/${encodeURIComponent(msg.video.id)}" class="msg-video-card-play-overlay" title="Play Video">
                            <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20"><polygon points="6,4 20,12 6,20"/></svg>
                        </a>
                        ${msg.video.duration ? `<div class="msg-video-card-duration">${h(msg.video.duration)}</div>` : ''}
                    </div>
                    <div class="msg-video-card-info">
                        <div class="msg-video-card-title">${h(msg.video.title)}</div>
                        <div class="msg-video-card-actions">
                            <a href="/watch/${encodeURIComponent(msg.video.id)}" class="msg-video-action-btn btn-watch-now">
                                <svg viewBox="0 0 24 24" fill="currentColor" width="12" height="12"><polygon points="6,4 20,12 6,20"/></svg>
                                <span>Watch</span>
                            </a>
                            <a href="/watch/${encodeURIComponent(msg.video.id)}?wt_invite=1" class="msg-video-action-btn btn-wt-together">
                                <span>🍿 Watch Together</span>
                            </a>
                        </div>
                    </div>
                </div>
            `;
        }

        let voicePlayerHtml = '';
        if (msg.voiceUrl) {
            voicePlayerHtml = `
                <div class="msg-voice-player" data-audio-src="${h(msg.voiceUrl)}">
                    <button type="button" class="msg-voice-play-btn" aria-label="Play voice note">
                        <svg class="icon-play" viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><polygon points="6,4 20,12 6,20"/></svg>
                        <svg class="icon-pause" viewBox="0 0 24 24" fill="currentColor" width="16" height="16" style="display:none;"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>
                    </button>
                    <div class="msg-voice-waveform-wrap">
                        <div class="msg-voice-waveform">
                            <span class="msg-wave-bar"></span>
                            <span class="msg-wave-bar"></span>
                            <span class="msg-wave-bar"></span>
                            <span class="msg-wave-bar"></span>
                            <span class="msg-wave-bar"></span>
                            <span class="msg-wave-bar"></span>
                            <span class="msg-wave-bar"></span>
                            <span class="msg-wave-bar"></span>
                            <span class="msg-wave-bar"></span>
                            <span class="msg-wave-bar"></span>
                        </div>
                        <div class="msg-voice-meta">
                            <span class="msg-voice-time">Voice Note</span>
                            <button type="button" class="msg-voice-speed-btn" data-speed="1">1x</button>
                        </div>
                    </div>
                </div>
            `;
        }

function renderCallEventHtml(rawText, isOut, timeStr) {
    try {
        const jsonStr = rawText.replace('__CALL_EVENT__:', '');
        const data = JSON.parse(jsonStr);
        const isVideo = data.callType === 'video';
        const status = data.status || 'completed';
        const durationSeconds = Number(data.durationSeconds || 0);

        let title = '';
        let subtitle = '';
        let statusTag = '';
        let statusClass = '';
        let directionBadge = '';
        let iconSvg = '';

        if (status === 'completed') {
            statusClass = 'call-status-completed';
            const mins = Math.floor(durationSeconds / 60);
            const secs = durationSeconds % 60;
            const durStr = mins > 0 ? `${mins}m ${secs}s` : `${secs}s`;
            
            title = isOut
                ? (isVideo ? 'Outgoing Video Call' : 'Outgoing Voice Call')
                : (isVideo ? 'Incoming Video Call' : 'Incoming Voice Call');
            statusTag = 'Connected';
            subtitle = `${durStr} • HD Audio/Video`;

            directionBadge = isOut
                ? `<span class="msg-call-dir-badge dir-outgoing" title="Outgoing Answered"><svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="3"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg></span>`
                : `<span class="msg-call-dir-badge dir-incoming" title="Incoming Answered"><svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="3"><line x1="17" y1="7" x2="7" y2="17"/><polyline points="17 17 7 17 7 7"/></svg></span>`;

        } else if (status === 'missed') {
            statusClass = 'call-status-missed';
            if (isOut) {
                title = isVideo ? 'Outgoing Video Call' : 'Outgoing Voice Call';
                statusTag = 'No Answer';
                subtitle = 'Partner was unavailable';
                directionBadge = `<span class="msg-call-dir-badge dir-missed-out" title="Outgoing Unanswered"><svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="3"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg></span>`;
            } else {
                title = isVideo ? 'Missed Video Call' : 'Missed Voice Call';
                statusTag = 'Missed';
                subtitle = 'Tap below to return call';
                directionBadge = `<span class="msg-call-dir-badge dir-missed" title="Missed Call"><svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="3"><line x1="17" y1="7" x2="7" y2="17"/><polyline points="17 17 7 17 7 7"/></svg></span>`;
            }

        } else if (status === 'rejected') {
            statusClass = 'call-status-rejected';
            if (isOut) {
                title = isVideo ? 'Video Call Declined' : 'Voice Call Declined';
                statusTag = 'Busy';
                subtitle = 'Partner declined the call';
                directionBadge = `<span class="msg-call-dir-badge dir-rejected" title="Declined"><svg viewBox="0 0 24 24" width="10" height="10" fill="none" stroke="currentColor" stroke-width="3"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></span>`;
            } else {
                title = isVideo ? 'Declined Video Call' : 'Declined Voice Call';
                statusTag = 'Declined';
                subtitle = 'You declined the call';
                directionBadge = `<span class="msg-call-dir-badge dir-rejected" title="Declined"><svg viewBox="0 0 24 24" width="10" height="10" fill="none" stroke="currentColor" stroke-width="3"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></span>`;
            }

        } else {
            statusClass = 'call-status-cancelled';
            if (isOut) {
                title = isVideo ? 'Cancelled Video Call' : 'Cancelled Voice Call';
                statusTag = 'Cancelled';
                subtitle = 'Cancelled before answer';
                directionBadge = `<span class="msg-call-dir-badge dir-cancelled" title="Cancelled"><svg viewBox="0 0 24 24" width="10" height="10" fill="none" stroke="currentColor" stroke-width="3"><polyline points="9 14 4 9 9 4"/><path d="M20 20v-7a4 4 0 0 0-4-4H4"/></svg></span>`;
            } else {
                title = isVideo ? 'Missed Video Call' : 'Missed Voice Call';
                statusTag = 'Missed';
                subtitle = 'Caller cancelled';
                directionBadge = `<span class="msg-call-dir-badge dir-missed" title="Missed Call"><svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="3"><line x1="17" y1="7" x2="7" y2="17"/><polyline points="17 17 7 17 7 7"/></svg></span>`;
            }
        }

        if (isVideo) {
            iconSvg = `<svg class="msg-call-main-glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
                <polygon points="23 7 16 12 23 17 23 7"/>
                <rect x="1" y="5" width="15" height="14" rx="3" ry="3"/>
            </svg>`;
        } else {
            iconSvg = `<svg class="msg-call-main-glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" width="19" height="19">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>`;
        }

        const callBackBtn = `
            <button type="button" class="msg-call-action-pill ${isVideo ? 'btn-trigger-video-call' : 'btn-trigger-audio-call'}" title="${isVideo ? 'Start Video Call' : 'Start Voice Call'}">
                ${isVideo
                    ? `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" width="13" height="13"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg><span>Video</span>`
                    : `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" width="13" height="13"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg><span>Call Back</span>`
                }
            </button>
        `;

        return `
            <div class="msg-call-event-card ${statusClass} ${isVideo ? 'is-video' : 'is-audio'} ${isOut ? 'is-outgoing' : 'is-incoming'}">
                <div class="msg-call-glow-edge"></div>
                <div class="msg-call-icon-container">
                    ${status === 'missed' && !isOut ? '<span class="msg-call-pulse-ring"></span>' : ''}
                    <div class="msg-call-icon-inner">
                        ${iconSvg}
                    </div>
                    ${directionBadge}
                </div>
                <div class="msg-call-info">
                    <div class="msg-call-headline">
                        <span class="msg-call-title">${h(title)}</span>
                        <span class="msg-call-status-badge ${statusClass}">${h(statusTag)}</span>
                    </div>
                    <div class="msg-call-meta-line">
                        <span class="msg-call-subtitle">${h(subtitle)}</span>
                        ${timeStr ? `<span class="msg-call-time-dot">•</span><span class="msg-call-time-chip">${h(timeStr)}</span>` : ''}
                    </div>
                </div>
                <div class="msg-call-actions">
                    ${callBackBtn}
                </div>
            </div>
        `;
    } catch {
        return `<div class="msg-text-content">${h(rawText)}</div>`;
    }
}

        const isCallEvent = !!(msg.text && msg.text.startsWith('__CALL_EVENT__:'));
        const emojiStats = (!msg.video && !msg.voiceUrl && !msg.replyTo && !isCallEvent && msg.text) ? getEmojiStats(msg.text) : { isEmojiOnly: false, count: 0 };
        let textContentHtml = '';
        if (msg.text) {
            if (isCallEvent) {
                textContentHtml = renderCallEventHtml(msg.text, isOut, timeStr);
            } else {
                const jumboClass = emojiStats.isEmojiOnly ? ` msg-jumbo-${Math.min(emojiStats.count, 4)}` : '';
                textContentHtml = `<div class="msg-text-content${jumboClass}">${h(msg.text).replace(/\n/g, '<br>')}</div>`;
            }
        }

        const reactionsHtml = renderReactionsHtml(msg.reactions, currentUser);
        const canDelete = isOut || currentUser === 'muaj';
        const finalRowClass = `${rowClass} ${isCallEvent ? 'msg-row-call-event' : ''}`;
        const bubbleClass = `msg-bubble ${emojiStats.isEmojiOnly ? 'is-emoji-only-bubble' : ''}`;

        return `
            ${dateDivider}
            <div class="msg-row ${finalRowClass}" data-msg-id="${msg.id}" ${isCallEvent ? 'data-is-call="true"' : ''}>
                <div class="msg-action-toolbar">
                    <div class="msg-quick-react-pill">
                        <button type="button" class="msg-react-emoji-btn" data-emoji="❤️">❤️</button>
                        <button type="button" class="msg-react-emoji-btn" data-emoji="🔥">🔥</button>
                        <button type="button" class="msg-react-emoji-btn" data-emoji="😂">😂</button>
                        <button type="button" class="msg-react-emoji-btn" data-emoji="🍿">🍿</button>
                    </div>
                    ${!isCallEvent ? `
                    <button type="button" class="msg-action-btn btn-reply" title="Reply to Message" data-reply-id="${msg.id}">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" width="13" height="13"><polyline points="9 17 4 12 9 7"/><path d="M20 18v-2a4 4 0 0 0-4-4H4"/></svg>
                    </button>
                    ` : ''}
                    ${msg.text && !isCallEvent ? `<button type="button" class="msg-action-btn btn-copy" title="Copy Text">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="13" height="13"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                    </button>` : ''}
                    ${canDelete ? `<button type="button" class="msg-action-btn btn-delete" title="Delete Message">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="13" height="13"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                    </button>` : ''}
                </div>
                <div class="msg-bubble-wrap">
                    <div class="${bubbleClass}">
                        ${renderReplyQuoteHtml(msg.replyTo, currentUser)}
                        ${videoCardHtml}
                        ${voicePlayerHtml}
                        ${textContentHtml}
                    </div>
                    ${reactionsHtml}
                    ${!isCallEvent ? `
                    <div class="msg-meta-row">
                        <span class="msg-time">${timeStr}</span>
                        ${seenHtml}
                    </div>
                    ` : `
                    <div class="msg-meta-row msg-call-meta-bottom">
                        ${seenHtml}
                    </div>
                    `}
                </div>
            </div>
        `;
    }).join('');
}

const videoOptionsHtml = videoList.map(v => `
    <div class="msg-attach-item" data-video-id="${h(v.id)}">
        <img src="${v.thumbnail ? '/thumbnails/' + encodeURIComponent(v.thumbnail) : ''}" class="msg-attach-thumb" alt="" />
        <span class="msg-attach-title">${h(v.title)}</span>
    </div>
`).join('');
%>

<%- include('layout', { pageTitle: 'Direct Chat with ' + partnerName, isMessagesPage: true, page: 'messages', body: `
<div class="app-container msg-page-shell">
    <a href="/dashboard" class="msg-skip-link">Back to video library</a>

    <!-- Android-first responsive messaging workspace -->
    <main class="msg-fullpage-container">
        <!-- Sidebar: Partner Profile & Quick Stats -->
        <aside class="msg-fullpage-sidebar" id="msgConversationDetails" aria-label="Conversation details">
            <div class="msg-details-sheet-header">
                <div>
                    <span class="msg-details-eyebrow">Conversation</span>
                    <h2>Details</h2>
                </div>
                <button type="button" class="msg-icon-button msg-details-close" id="msgDetailsCloseBtn" aria-label="Close conversation details">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" width="22" height="22"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </button>
            </div>
            <div class="msg-sidebar-profile">
                <div class="msg-sidebar-avatar-wrap">
                    ${typeof renderAvatar === 'function' ? renderAvatar(currentPartner, 'msg-sidebar-avatar') : ''}
                    <span class="msg-status-dot msg-partner-status-dot ${statusClass}"></span>
                </div>
                <h3 class="msg-header-name" style="font-size: 19px; margin-bottom: 5px;">${h(partnerName)}</h3>
                <span class="msg-role-tag ${partnerRoleClass}">${partnerRole}</span>
                <p class="msg-header-presence-sub msg-partner-presence-text" style="margin-top: 8px; justify-content: center;">
                    ${presenceText}
                </p>
            </div>

            <!-- Live Watching Card -->
            <div class="msg-sidebar-watching-card" id="msgSidebarWatchingBanner" ${isWatching && presence.videoTitle ? 'style="display:flex;"' : 'style="display:none;"'}>
                <div class="msg-sidebar-watching-header">
                    <span class="msg-status-dot dot-watching" style="position:static; width:9px; height:9px;"></span>
                    <span>Currently Watching</span>
                </div>
                <div class="msg-sidebar-watching-title">${h(presence.videoTitle || '')}</div>
                <a href="${presence.currentVideoId ? '/watch/' + encodeURIComponent(presence.currentVideoId) : '#'}" class="btn btn-primary btn-sm msg-sidebar-watching-join" style="padding: 4px 10px; font-size: 11px; justify-content: center;">
                    <svg viewBox="0 0 24 24" fill="currentColor" width="12" height="12"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                    <span>Join Stream</span>
                </a>
            </div>

            <!-- Stats Grid -->
            <div class="msg-sidebar-stats-grid">
                <div class="msg-stat-card">
                    <div class="msg-stat-value" id="msgStatTotalMessages">${h(msgStats.totalMessages || 0)}</div>
                    <div class="msg-stat-label">Messages</div>
                </div>
                <div class="msg-stat-card">
                    <div class="msg-stat-value" id="msgStatSharedVideos">${h(msgStats.sharedVideos || 0)}</div>
                    <div class="msg-stat-label">Shared Clips</div>
                </div>
                <div class="msg-stat-card">
                    <div class="msg-stat-value" id="msgStatVoiceMessages">${h(msgStats.voiceMessages || 0)}</div>
                    <div class="msg-stat-label">Voice Notes</div>
                </div>
                <div class="msg-stat-card">
                    <div class="msg-stat-value" id="msgStatCalls">${h(msgStats.totalCalls || 0)}</div>
                    <div class="msg-stat-label">Calls</div>
                </div>
            </div>

            <!-- Shared Media Explorer Tabs -->
            <div class="msg-sidebar-media-tabs">
                <button type="button" class="msg-media-tab-btn is-active" data-tab="all">
                    <span>💬 All Messages</span>
                </button>
                <button type="button" class="msg-media-tab-btn" data-tab="videos">
                    <span>🎬 Shared Videos</span>
                    <span class="tab-count" id="msgTabCountVideos">${h(msgStats.sharedVideos || 0)}</span>
                </button>
                <button type="button" class="msg-media-tab-btn" data-tab="voice">
                    <span>🎙️ Voice Notes</span>
                    <span class="tab-count" id="msgTabCountVoice">${h(msgStats.voiceMessages || 0)}</span>
                </button>
                <button type="button" class="msg-media-tab-btn" data-tab="calls">
                    <span>📞 Call Logs</span>
                    <span class="tab-count" id="msgTabCountCalls">${h(msgStats.totalCalls || 0)}</span>
                </button>
            </div>
        </aside>

        <!-- Main Chat Area -->
        <section class="msg-fullpage-main">
            <!-- Header -->
            <header class="msg-header">
                <a href="/dashboard" class="msg-icon-button msg-header-back" aria-label="Back to video library">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" width="24" height="24"><line x1="20" y1="12" x2="4" y2="12"/><polyline points="10 18 4 12 10 6"/></svg>
                </a>
                <div class="msg-header-user-group">
                    <div class="msg-header-avatar-wrap">
                        ${typeof renderAvatar === 'function' ? renderAvatar(currentPartner, 'msg-header-avatar') : ''}
                        <span class="msg-status-dot msg-partner-status-dot ${statusClass}"></span>
                    </div>
                    <div class="msg-header-details">
                        <div class="msg-header-name-row">
                            <h2 class="msg-header-name">${h(partnerName)}</h2>
                            <span class="msg-role-tag ${partnerRoleClass}">${partnerRole}</span>
                        </div>
                        <div class="msg-header-presence-sub msg-partner-presence-text">${presenceText}</div>
                    </div>
                </div>
                <div class="msg-header-actions">
                    <button type="button" class="msg-hdr-call-btn" id="msgHeaderAudioCallBtn" title="Start Audio Call with ${h(partnerName)}">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" width="18" height="18">
                            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                        </svg>
                    </button>
                    <button type="button" class="msg-hdr-call-btn btn-video-call" id="msgHeaderVideoCallBtn" title="Start Video Call with ${h(partnerName)}">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" width="19" height="19">
                            <polygon points="23 7 16 12 23 17 23 7"/>
                            <rect x="1" y="5" width="15" height="14" rx="2" ry="2"/>
                        </svg>
                    </button>
                    <button type="button" class="msg-hdr-btn" id="msgSearchToggleBtn" title="Search in Conversation">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="17" height="17">
                            <circle cx="11" cy="11" r="8"/>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                        </svg>
                    </button>
                    <button type="button" class="msg-hdr-btn" id="msgDetailsToggleBtn" title="Conversation details" aria-label="Open conversation details" aria-controls="msgConversationDetails" aria-expanded="false">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                    </button>
                </div>
            </header>

            <!-- In-Chat Search Bar Dropdown -->
            <div class="msg-inchat-search-bar" id="msgInChatSearchBar">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15" style="color: var(--msg-text-muted);">
                    <circle cx="11" cy="11" r="8"/>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                </svg>
                <input type="text" class="msg-inchat-search-input" id="msgInChatSearchInput" placeholder="Search text in conversation..." autocomplete="off" />
                <button type="button" class="msg-inchat-search-close" id="msgInChatSearchClose" title="Clear Search">&times;</button>
            </div>

            <!-- Messages Thread -->
            <div class="msg-body-container" id="msgFullpageList">
                ${messagesListHtml}
            </div>

            <!-- Full-Page Composer -->
            <div class="msg-footer msg-composer-wrap">
                <!-- Attach Video Modal -->
                <div class="msg-attach-video-modal">
                    <div class="msg-attach-header">
                        <span>Attach Video to Chat</span>
                    </div>
                    <input type="text" class="msg-attach-search-input" placeholder="Search library videos..." />
                    <div class="msg-attach-list">
                        ${videoOptionsHtml}
                    </div>
                </div>

                <!-- Recording Bar (Visible only when recording is active) -->
                <div class="msg-recording-bar" style="display:none;">
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <span class="msg-rec-dot"></span>
                        <span class="msg-rec-label">🎙️ Recording...</span>
                        <span class="msg-rec-active-label">Recording Voice Note... <span class="msg-rec-timer">0:00</span></span>
                    </div>
                    <div style="display: flex; gap: 6px;">
                        <button type="button" class="btn btn-ghost btn-sm msg-rec-cancel-btn">Cancel</button>
                        <button type="button" class="btn btn-primary btn-sm msg-rec-send-btn">Send Voice</button>
                    </div>
                </div>

                <!-- Quoted Reply Preview Bar (WhatsApp-style) -->
                <div class="msg-reply-bar" id="msgReplyBar" style="display:none;">
                    <div class="msg-reply-bar-left">
                        <div class="msg-reply-bar-indicator"></div>
                        <div class="msg-reply-bar-details">
                            <div class="msg-reply-bar-header">
                                <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 17 4 12 9 7"/><path d="M20 18v-2a4 4 0 0 0-4-4H4"/></svg>
                                <span class="msg-reply-bar-name">Replying to ${h(partnerName)}</span>
                            </div>
                            <div class="msg-reply-bar-snippet">...</div>
                        </div>
                    </div>
                    <div class="msg-reply-bar-right">
                        <div class="msg-reply-bar-thumb" style="display:none;"></div>
                        <button type="button" class="msg-reply-bar-cancel" title="Cancel reply" aria-label="Cancel reply">&times;</button>
                    </div>
                </div>

                <!-- Input Row -->
                <div class="msg-input-row">
                    <button type="button" class="msg-composer-btn msg-attach-btn" title="Share a Video" aria-label="Open attachments" aria-expanded="false">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="20" height="20" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M15 10l4.553-2.276A1 1 0 0 1 21 8.618v6.764a1 1 0 0 1-1.447.894L15 14"/>
                            <rect x="3" y="6" width="12" height="12" rx="2"/>
                        </svg>
                    </button>

                    <button type="button" class="msg-composer-btn msg-emoji-toggle-btn" title="Open WhatsApp Emojis" aria-label="Open Emoji Picker">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" width="20" height="20" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"/>
                            <path d="M8 14s1.5 2 4 2 4-2 4-2"/>
                            <line x1="9" y1="9" x2="9.01" y2="9" stroke-width="3"/>
                            <line x1="15" y1="9" x2="15.01" y2="9" stroke-width="3"/>
                        </svg>
                    </button>

                    <div class="msg-input-wrap">
                        <textarea class="msg-textarea" placeholder="Type a message to ${h(partnerName)}..." rows="1"></textarea>
                    </div>

                    <button type="button" class="msg-composer-btn msg-mic-btn" title="Record Voice Note">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="20" height="20" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="9" y="2" width="6" height="12" rx="3"/>
                            <path d="M19 10v1a7 7 0 0 1-14 0v-1"/>
                            <line x1="12" y1="18" x2="12" y2="22"/>
                            <line x1="8" y1="22" x2="16" y2="22"/>
                        </svg>
                    </button>

                    <button type="button" class="msg-send-btn" title="Send Message">
                        <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
                            <path d="M3.478 2.405a.75.75 0 0 0-.926.94l2.432 7.905H13.5a.75.75 0 0 1 0 1.5H4.984l-2.432 7.905a.75.75 0 0 0 .926.94 60.519 60.519 0 0 0 18.445-8.986.75.75 0 0 0 0-1.218A60.517 60.517 0 0 0 3.478 2.405z"/>
                        </svg>
                    </button>
                </div>
            </div>
        </section>
    </main>

    <button type="button" class="msg-details-backdrop" id="msgDetailsBackdrop" aria-label="Close conversation details" tabindex="-1"></button>

    <!-- Mobile Message Long-Press Action Sheet -->
    <div class="msg-mobile-actions-backdrop" id="msgMobileActionsBackdrop" style="display:none;" role="dialog" aria-modal="true" aria-label="Message actions">
        <div class="msg-mobile-actions-sheet" id="msgMobileActionsSheet">
            <div class="msg-mobile-actions-pill"></div>
            <div class="msg-mobile-reactions-row">
                <button type="button" class="msg-mobile-react-btn" data-emoji="❤️">❤️</button>
                <button type="button" class="msg-mobile-react-btn" data-emoji="🔥">🔥</button>
                <button type="button" class="msg-mobile-react-btn" data-emoji="😂">😂</button>
                <button type="button" class="msg-mobile-react-btn" data-emoji="🍿">🍿</button>
                <button type="button" class="msg-mobile-react-btn" data-emoji="🥺">🥺</button>
                <button type="button" class="msg-mobile-react-btn" data-emoji="👍">👍</button>
            </div>
            <div class="msg-mobile-actions-list">
                <button type="button" class="msg-mobile-action-item btn-mobile-reply">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><polyline points="9 17 4 12 9 7"/><path d="M20 18v-2a4 4 0 0 0-4-4H4"/></svg>
                    <span>Reply</span>
                </button>
                <button type="button" class="msg-mobile-action-item btn-mobile-copy">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                    <span>Copy Text</span>
                </button>
                <button type="button" class="msg-mobile-action-item btn-mobile-delete" style="display:none; color:#ef4444;">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                    <span>Delete Message</span>
                </button>
            </div>
        </div>
    </div>
</div>
` }) %>
