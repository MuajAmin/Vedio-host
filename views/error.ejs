<%
const h = typeof escapeHtml === 'function' ? escapeHtml : (str => String(str || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;'));
const isHajera = typeof user !== 'undefined' && user === 'hajera';
const destination = (typeof user !== 'undefined' && user) ? '/dashboard' : '/';
const label = (typeof user !== 'undefined' && user) ? 'Go to Dashboard' : 'Go to Login';
%>
<%- include('layout', { pageTitle: 'Error', body: `
<div class="app-container ${isHajera ? 'hajera-mode' : ''}">
    ${isHajera ? '<div class="floating-hearts-container" id="floatingHeartsContainer"></div>' : ''}
    ${isHajera ? '<div class="sparkle-trail-container" id="sparkleTrailContainer"></div>' : ''}
    <div class="error-container">
    <div class="error-content">
        <div class="error-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="80" height="80">
                <circle cx="12" cy="12" r="10"/>
                <line x1="15" y1="9" x2="9" y2="15"/>
                <line x1="9" y1="9" x2="15" y2="15"/>
            </svg>
        </div>
        <h1>Something went wrong</h1>
        <p>${h(message || 'Unexpected error.')}</p>
        <a href="${destination}" class="btn btn-primary">${label}</a>
    </div>
    </div>
</div>
` }) %>
