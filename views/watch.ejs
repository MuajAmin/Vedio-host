<%
const h = escapeHtml;
const isAdmin = user === 'muaj';
const isHajera = user === 'hajera';
const displayName = isAdmin ? 'Muaj' : 'Hajera';

function formatDate(value, withTime) {
    if (!value) return '';
    const date = new Date(value);
    const formatted = date.toLocaleDateString('bn-BD', {
        day: 'numeric',
        month: withTime ? 'short' : 'long',
        year: 'numeric'
    });

    if (!withTime) return formatted;

    return formatted + ' ' + date.toLocaleTimeString('bn-BD', {
        hour: '2-digit',
        minute: '2-digit'
    });
}

function mimeTypeFor(filename) {
    const ext = String(filename || '').toLowerCase().split('.').pop();
    const mimeMap = {
        mp4: 'video/mp4',
        m4v: 'video/mp4',
        webm: 'video/webm',
        mov: 'video/quicktime',
        mkv: 'video/x-matroska',
        avi: 'video/x-msvideo',
        flv: 'video/x-flv',
        wmv: 'video/x-ms-wmv'
    };
    return mimeMap[ext] || 'video/mp4';
}

const videoId = encodeURIComponent(video.id);
const streamUrl = '/stream/' + videoId;
const sourceType = mimeTypeFor(video.filename || video.original_name);
const posterAttr = video.thumbnail ? `poster="/thumbnails/${h(video.thumbnail)}"` : '';
const savedProgress = progress || {};
const savedPosition = Number(savedProgress.position_seconds || 0);
const thumbMessage = typeof thumbnail !== 'undefined' ? thumbnail : '';
const deleteForm = `<form action="/delete/${videoId}" method="POST" data-confirm="Delete this video? This cannot be undone."><input type="hidden" name="_csrf" value="${h(csrfToken)}"><button type="submit" class="btn btn-danger"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg><span>Delete</span></button></form>`;

const commentsHtml = comments.length === 0
    ? '<div class="no-comments"><p>No comments yet.</p></div>'
    : comments.map((c) => {
        const canDelete = isAdmin || user === c.user;
        const commentDeleteForm = canDelete
            ? `<form action="/comment/delete/${encodeURIComponent(c.id)}" method="POST" class="comment-delete-form"><input type="hidden" name="_csrf" value="${h(csrfToken)}"><button type="submit" class="btn-icon" title="Delete comment"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button></form>`
            : '';

        return `<div class="comment-item"><div class="comment-avatar ${c.user === 'muaj' ? 'avatar-admin' : 'avatar-viewer'}">${c.user === 'muaj' ? 'M' : 'H'}</div><div class="comment-body"><div class="comment-header"><span class="comment-author">${c.user === 'muaj' ? 'Muaj' : 'Hajera'}</span><span class="comment-time">${h(formatDate(c.created_at, true))}</span>${commentDeleteForm}</div><p class="comment-text">${h(c.text)}</p></div></div>`;
    }).join('');
%>
<%- include('layout', { pageTitle: video.title, body: `
<div class="app-container ${isHajera ? 'hajera-mode' : ''}">
    <div class="ambient-background">
        <div class="ambient-orb orb-1"></div>
        <div class="ambient-orb orb-2"></div>
    </div>

    ${isHajera ? '<div class="floating-hearts-container" id="floatingHeartsContainer"></div>' : ''}
    ${isHajera ? '<div class="sparkle-trail-container" id="sparkleTrailContainer"></div>' : ''}

    <nav class="navbar">
        <div class="nav-left">
            <a href="/dashboard" class="nav-logo">
                <div class="logo-icon-wrapper">
                    <svg viewBox="0 0 48 48" fill="none" width="24" height="24">
                        <rect x="4" y="8" width="40" height="32" rx="6" stroke="currentColor" stroke-width="2.5"/>
                        <polygon points="20,16 34,24 20,32" fill="currentColor"/>
                    </svg>
                </div>
                <span>Video<em>Host</em></span>
            </a>
        </div>
        <div class="nav-right">
            <a href="/dashboard" class="btn btn-ghost">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                    <line x1="19" y1="12" x2="5" y2="12"/>
                    <polyline points="12 19 5 12 12 5"/>
                </svg>
                <span>Back</span>
            </a>
            <button type="button" class="btn btn-ghost btn-icon" id="themeSwitcherNavBtn" title="Change Theme">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                    <circle cx="12" cy="12" r="10"/>
                    <path d="M12 2a10 10 0 0 0 0 20z" fill="currentColor" opacity="0.4"/>
                </svg>
            </button>
            <div class="user-badge ${isAdmin ? 'badge-admin' : 'badge-viewer'}">
                <div class="badge-avatar">${isAdmin ? 'M' : 'H'}</div>
                <span>${displayName}</span>
            </div>
        </div>
    </nav>

    <main class="main-content watch-page">
        <div class="vp-cinema vp-muted" id="playerContainer">
            <!-- Resume Toast -->
            <div id="resumeToast" class="resume-toast" style="display: none;">
                <span>▶ Continue watching from <strong id="resumeTimeStr">0:00</strong>?</span>
                <div class="resume-actions">
                    <button type="button" class="btn btn-sm btn-primary" id="btnResumeYes">Resume</button>
                    <button type="button" class="btn btn-sm btn-ghost" id="btnResumeNo">Start Over</button>
                </div>
            </div>

            <!-- Center Play/Pause Overlay -->
            <div class="vp-center-overlay" id="vpCenterOverlay">
                <div class="vp-center-btn" id="vpCenterPlayBtn">
                    <svg class="vp-play-icon" viewBox="0 0 24 24" fill="currentColor" width="44" height="44">
                        <polygon points="6,3 20,12 6,21"/>
                    </svg>
                    <svg class="vp-pause-icon" viewBox="0 0 24 24" fill="currentColor" width="44" height="44" style="display:none">
                        <rect x="5" y="3" width="4" height="18" rx="1"/>
                        <rect x="15" y="3" width="4" height="18" rx="1"/>
                    </svg>
                </div>
            </div>

            <!-- Seek Gesture Ripples -->
            <div class="vp-seek-ripple vp-seek-left" id="seekRippleLeft">
                <div class="vp-ripple-content">
                    <svg viewBox="0 0 24 24" fill="currentColor" width="26" height="26"><polygon points="11,19 2,12 11,5"/><polygon points="22,19 13,12 22,5"/></svg>
                    <span>10s</span>
                </div>
            </div>
            <div class="vp-seek-ripple vp-seek-right" id="seekRippleRight">
                <div class="vp-ripple-content">
                    <svg viewBox="0 0 24 24" fill="currentColor" width="26" height="26"><polygon points="13,19 22,12 13,5"/><polygon points="2,19 11,12 2,5"/></svg>
                    <span>10s</span>
                </div>
            </div>

            <!-- The Video Element -->
            <video id="vpVideo" ${posterAttr} preload="metadata" playsinline muted data-video-id="${h(video.id)}" data-stream-url="${h(streamUrl)}" data-source-type="${h(sourceType)}" data-saved-position="${h(savedPosition)}" data-progress-url="/watch-progress/${videoId}" data-csrf-token="${h(csrfToken)}">
                <source src="${h(streamUrl)}" type="${h(sourceType)}">
            </video>

            <!-- Playback Status / Slow Network UI -->
            <div class="vp-audio-chip" id="vpAudioChip" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18">
                    <path d="M3 9v6h4l5 5V4L7 9H3z"/>
                    <line x1="22" y1="9" x2="16" y2="15" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
                    <line x1="16" y1="9" x2="22" y2="15" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
                </svg>
            </div>

            <div class="vp-loading-overlay" id="vpLoadingOverlay" aria-live="polite" aria-hidden="true">
                <div class="vp-loading-panel">
                    <div class="vp-spinner" aria-hidden="true"></div>
                    <div class="vp-loading-copy">
                        <p class="vp-loading-title" id="vpLoadingTitle"></p>
                        <p class="vp-loading-detail" id="vpLoadingDetail"></p>
                    </div>
                    <button type="button" class="vp-retry-btn" id="vpRetryBtn">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                            <path d="M21 12a9 9 0 1 1-3-6.7"/>
                            <path d="M21 3v6h-6"/>
                        </svg>
                        <span>Retry stream</span>
                    </button>
                </div>
            </div>

            <!-- Bottom Gradient Fade -->
            <div class="vp-bottom-gradient"></div>

            <!-- Custom Controls Bar -->
            <div class="vp-controls" id="vpControls">
                <!-- Progress Bar -->
                <div class="vp-progress-wrap" id="vpProgressWrap">
                    <div class="vp-progress-buffer" id="vpProgressBuffer"></div>
                    <div class="vp-progress-played" id="vpProgressPlayed">
                        <div class="vp-progress-thumb" id="vpProgressThumb"></div>
                    </div>
                    <div class="vp-progress-hover-time" id="vpHoverTime">0:00</div>
                </div>

                <!-- Controls Row -->
                <div class="vp-controls-row">
                    <!-- Left Controls -->
                    <div class="vp-controls-left">
                        <button type="button" class="vp-btn" id="vpPlayBtn" title="Play/Pause (K)" aria-label="Play or pause">
                            <svg class="vp-icon-play" viewBox="0 0 24 24" fill="currentColor" width="22" height="22">
                                <polygon points="6,3 20,12 6,21"/>
                            </svg>
                            <svg class="vp-icon-pause" viewBox="0 0 24 24" fill="currentColor" width="22" height="22" style="display:none">
                                <rect x="5" y="3" width="4" height="18" rx="1"/>
                                <rect x="15" y="3" width="4" height="18" rx="1"/>
                            </svg>
                        </button>

                        <button type="button" class="vp-btn vp-btn-seek" id="vpRewindBtn" title="Rewind 10s (J)" aria-label="Rewind 10 seconds">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
                                <path d="M12.5 8V4L7 8.5l5.5 4V9c3.87 0 7 3.13 7 7s-3.13 7-7 7-7-3.13-7-7H4c0 4.97 4.03 9 9 9s9-4.03 9-9-4.03-9-9-9z" fill="currentColor" stroke="none"/>
                            </svg>

                        </button>

                        <button type="button" class="vp-btn vp-btn-seek" id="vpForwardBtn" title="Forward 10s (L)" aria-label="Forward 10 seconds">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20" style="transform: scaleX(-1)">
                                <path d="M12.5 8V4L7 8.5l5.5 4V9c3.87 0 7 3.13 7 7s-3.13 7-7 7-7-3.13-7-7H4c0 4.97 4.03 9 9 9s9-4.03 9-9-4.03-9-9-9z" fill="currentColor" stroke="none"/>
                            </svg>

                        </button>

                        <!-- Volume -->
                        <div class="vp-volume-group">
                            <button type="button" class="vp-btn vp-btn-muted" id="vpMuteBtn" title="Unmute (M)" aria-label="Unmute" aria-pressed="true">
                                <svg class="vp-icon-vol-on" viewBox="0 0 24 24" fill="currentColor" width="20" height="20" style="display:none">
                                    <path d="M3 9v6h4l5 5V4L7 9H3z"/>
                                    <path d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02z" opacity="0.7"/>
                                    <path d="M19.07 4.93a10 10 0 0 1 0 14.14l-1.41-1.41a8 8 0 0 0 0-11.31l1.41-1.42z" opacity="0.4"/>
                                </svg>
                                <svg class="vp-icon-vol-off" viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
                                    <path d="M3 9v6h4l5 5V4L7 9H3z"/>
                                    <line x1="23" y1="9" x2="17" y2="15" stroke="currentColor" stroke-width="2"/>
                                    <line x1="17" y1="9" x2="23" y2="15" stroke="currentColor" stroke-width="2"/>
                                </svg>
                            </button>
                            <div class="vp-volume-slider-wrap">
                                <input type="range" min="0" max="100" value="0" class="vp-volume-slider" id="vpVolumeSlider" aria-label="Volume">
                            </div>
                        </div>

                        <div class="vp-time" id="vpTimeDisplay">
                            <span id="vpCurrentTime">0:00</span>
                            <span class="vp-time-sep">/</span>
                            <span id="vpDuration">0:00</span>
                        </div>
                    </div>

                    <!-- Right Controls -->
                    <div class="vp-controls-right">
                        <!-- Speed -->
                        <div class="vp-speed-group" id="vpSpeedGroup">
                            <button type="button" class="vp-btn vp-speed-btn" id="vpSpeedBtn" title="Playback Speed" aria-label="Playback speed">
                                <span id="vpSpeedLabel">1x</span>
                            </button>
                            <div class="vp-speed-menu" id="vpSpeedMenu">
                                <button class="vp-speed-option" data-speed="0.5">0.5x</button>
                                <button class="vp-speed-option" data-speed="0.75">0.75x</button>
                                <button class="vp-speed-option active" data-speed="1">Normal</button>
                                <button class="vp-speed-option" data-speed="1.25">1.25x</button>
                                <button class="vp-speed-option" data-speed="1.5">1.5x</button>
                                <button class="vp-speed-option" data-speed="2">2x</button>
                            </div>
                        </div>

                        <!-- PiP -->
                        <button type="button" class="vp-btn" id="vpPipBtn" title="Picture-in-Picture" aria-label="Picture-in-picture">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="19" height="19">
                                <rect x="2" y="3" width="20" height="14" rx="2"/>
                                <rect x="11" y="9" width="9" height="6" rx="1" fill="currentColor" opacity="0.35"/>
                            </svg>
                        </button>

                        <!-- Fullscreen -->
                        <button type="button" class="vp-btn vp-btn-fullscreen" id="vpFullscreenBtn" title="Fullscreen (F)" aria-label="Fullscreen">
                            <svg class="vp-icon-fs-enter" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="20" height="20">
                                <path d="M8 3H5a2 2 0 0 0-2 2v3"/>
                                <path d="M21 8V5a2 2 0 0 0-2-2h-3"/>
                                <path d="M16 21h3a2 2 0 0 0 2-2v-3"/>
                                <path d="M3 16v3a2 2 0 0 0 2 2h3"/>
                            </svg>
                            <svg class="vp-icon-fs-exit" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="20" height="20" style="display:none">
                                <path d="M4 14h3a2 2 0 0 1 2 2v3"/>
                                <path d="M20 10h-3a2 2 0 0 1-2-2V5"/>
                                <path d="M14 20v-3a2 2 0 0 1 2-2h3"/>
                                <path d="M10 4v3a2 2 0 0 1-2 2H5"/>
                            </svg>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="video-info-section">
            <div class="video-info-header">
                <div>
                    <h1 class="video-title">${h(video.title)}</h1>
                    <div class="video-meta">
                        <span class="meta-item">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14">
                                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                                <line x1="16" y1="2" x2="16" y2="6"/>
                                <line x1="8" y1="2" x2="8" y2="6"/>
                                <line x1="3" y1="10" x2="21" y2="10"/>
                            </svg>
                            ${h(formatDate(video.uploaded_at, false))}
                        </span>
                        ${video.size ? '<span class="meta-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>' + h((video.size / (1024 * 1024)).toFixed(1)) + ' MB</span>' : ''}
                    </div>
                </div>

                <div class="video-action-buttons">
                    <button type="button" class="btn btn-ghost btn-sm" id="btnTheaterMode" title="Toggle Cinema / Theater Mode">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                            <rect x="2" y="4" width="20" height="16" rx="2"/>
                            <path d="M6 8h12v8H6z"/>
                        </svg>
                        <span class="btn-text">Theater Mode</span>
                    </button>
                    <button type="button" class="btn btn-ghost btn-sm" id="btnShortcuts" title="Keyboard & Gesture Shortcuts">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                            <rect x="2" y="6" width="20" height="12" rx="2"/>
                            <line x1="6" y1="10" x2="6.01" y2="10"/>
                            <line x1="10" y1="10" x2="10.01" y2="10"/>
                            <line x1="14" y1="10" x2="14.01" y2="10"/>
                            <line x1="18" y1="10" x2="18.01" y2="10"/>
                            <line x1="8" y1="14" x2="16" y2="14"/>
                        </svg>
                        <span class="btn-text">Shortcuts</span>
                    </button>
                    <button type="button" class="btn btn-ghost btn-sm" id="btnDownload" title="Download Video">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                            <polyline points="7 10 12 15 17 10"/>
                            <line x1="12" y1="15" x2="12" y2="3"/>
                        </svg>
                        <span class="btn-text">Download</span>
                    </button>
                    ${deleteForm}
                </div>
            </div>
        </div>

        <section class="thumbnail-manager">
            <div class="thumbnail-preview-box">
                ${video.thumbnail ? `<img src="/thumbnails/${h(video.thumbnail)}" alt="${h(video.title)} thumbnail" class="thumb-img" loading="lazy">` : '<div class="thumb-placeholder"><svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" width="40" height="40"><rect x="6" y="10" width="36" height="28" rx="4"/><polygon points="20,18 32,24 20,30" fill="currentColor"/></svg></div>'}
            </div>
            <div class="thumbnail-manager-body">
                <div>
                    <h2>Thumbnail</h2>
                    <p>${thumbMessage === 'updated' ? 'Thumbnail updated.' : 'Upload a custom JPG, PNG, or WebP image.'}</p>
                </div>
                <form action="/thumbnail/${videoId}" method="POST" enctype="multipart/form-data" class="thumbnail-form">
                    <input type="hidden" name="_csrf" value="${h(csrfToken)}">
                    <input type="file" name="thumbnail" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" class="form-input thumbnail-input" required>
                    <button type="submit" class="btn btn-primary btn-sm">Upload Thumbnail</button>
                </form>
                <form action="/thumbnail/${videoId}/regenerate" method="POST" class="thumbnail-form-inline">
                    <input type="hidden" name="_csrf" value="${h(csrfToken)}">
                    <button type="submit" class="btn btn-ghost btn-sm">Regenerate</button>
                </form>
            </div>
        </section>

        <!-- Download Confirmation Modal -->
        <div class="theme-modal-backdrop" id="downloadModal">
            <div class="theme-modal">
                <div class="theme-modal-header">
                    <h3>📥 Confirm Download</h3>
                    <button type="button" class="theme-close-btn" id="downloadCloseBtn">&times;</button>
                </div>
                <div style="margin-bottom: 24px; text-align: center;">
                    <div style="font-size: 3rem; margin-bottom: 12px;">🎥</div>
                    <h4 style="font-size: 1.1rem; font-weight: 700; color: var(--text-primary); margin-bottom: 8px;">${h(video.title)}</h4>
                    <p style="font-size: 0.92rem; color: var(--text-muted); margin-bottom: 14px;">Do you want to download this video file to your device?</p>
                    ${video.size ? `<div style="display: inline-flex; align-items: center; gap: 6px; background: rgba(255,255,255,0.06); padding: 6px 14px; border-radius: 20px; font-size: 0.85rem; color: var(--accent-gold); border: 1px solid rgba(255,255,255,0.1);"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg> File Size: ` + h((video.size / (1024 * 1024)).toFixed(1)) + ` MB</div>` : ''}
                </div>
                <div style="display: flex; gap: 12px; justify-content: flex-end;">
                    <button type="button" class="btn btn-ghost" id="downloadCancelBtn">Cancel</button>
                    <a href="/download/${videoId}" class="btn btn-primary" id="downloadConfirmBtn" download>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                            <polyline points="7 10 12 15 17 10"/>
                            <line x1="12" y1="15" x2="12" y2="3"/>
                        </svg>
                        <span>Download Now</span>
                    </a>
                </div>
            </div>
        </div>

        <!-- Shortcuts Modal -->
        <div class="theme-modal-backdrop" id="shortcutsModal">
            <div class="theme-modal">
                <div class="theme-modal-header">
                    <h3>⌨️ Video Player Shortcuts</h3>
                    <button type="button" class="theme-close-btn" id="shortcutsCloseBtn">&times;</button>
                </div>
                <div class="shortcuts-grid">
                    <div class="shortcut-item"><kbd>Space</kbd> / <kbd>K</kbd> <span>Play / Pause</span></div>
                    <div class="shortcut-item"><kbd>J</kbd> / <kbd>←</kbd> <span>Rewind 10s</span></div>
                    <div class="shortcut-item"><kbd>L</kbd> / <kbd>→</kbd> <span>Forward 10s</span></div>
                    <div class="shortcut-item"><kbd>F</kbd> <span>Toggle Fullscreen</span></div>
                    <div class="shortcut-item"><kbd>M</kbd> <span>Mute / Unmute</span></div>
                    <div class="shortcut-item"><kbd>Double Tap</kbd> <span>±10s Seek (Mobile)</span></div>
                </div>
            </div>
        </div>

        <div class="comments-section">
            <h2 class="comments-title">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                </svg>
                Comments (${comments.length})
            </h2>

            <form action="/comment/${videoId}" method="POST" class="comment-form">
                <input type="hidden" name="_csrf" value="${h(csrfToken)}">
                <div class="comment-input-wrapper">
                    <div class="comment-avatar ${isAdmin ? 'avatar-admin' : 'avatar-viewer'}">${isAdmin ? 'M' : 'H'}</div>
                    <div class="comment-input-group">
                        <textarea name="text" placeholder="Write a comment..." rows="2" required maxlength="2000" class="comment-input"></textarea>
