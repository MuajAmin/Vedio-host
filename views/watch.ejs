<%
const h = escapeHtml;
const isAdmin = user === 'muaj';
const displayName = isAdmin ? 'Muaj' : 'Hajera';

function formatDate(value, withTime) {
    if (!value) return '';
    const date = new Date(value);
    const formatted = date.toLocaleDateString('bn-BD', {
        day: 'numeric',
        month: withTime ? 'short' : 'long',
        year: 'numeric'
    });

    if (!withTime) return formatted;

    return formatted + ' ' + date.toLocaleTimeString('bn-BD', {
        hour: '2-digit',
        minute: '2-digit'
    });
}

const videoId = encodeURIComponent(video.id);
const streamUrl = '/stream/' + videoId;
const deleteForm = isAdmin
    ? `<form action="/delete/${videoId}" method="POST" data-confirm="Delete this video? This cannot be undone."><input type="hidden" name="_csrf" value="${h(csrfToken)}"><button type="submit" class="btn btn-danger"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg><span>Delete</span></button></form>`
    : '';

const commentsHtml = comments.length === 0
    ? '<div class="no-comments"><p>No comments yet.</p></div>'
    : comments.map((c) => {
        const canDelete = isAdmin || user === c.user;
        const commentDeleteForm = canDelete
            ? `<form action="/comment/delete/${encodeURIComponent(c.id)}" method="POST" class="comment-delete-form"><input type="hidden" name="_csrf" value="${h(csrfToken)}"><button type="submit" class="btn-icon" title="Delete comment"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button></form>`
            : '';

        return `<div class="comment-item"><div class="comment-avatar ${c.user === 'muaj' ? 'avatar-admin' : 'avatar-viewer'}">${c.user === 'muaj' ? 'M' : 'H'}</div><div class="comment-body"><div class="comment-header"><span class="comment-author">${c.user === 'muaj' ? 'Muaj' : 'Hajera'}</span><span class="comment-time">${h(formatDate(c.created_at, true))}</span>${commentDeleteForm}</div><p class="comment-text">${h(c.text)}</p></div></div>`;
    }).join('');
%>
<%- include('layout', { pageTitle: video.title, body: `
<div class="app-container">
    <div class="ambient-background">
        <div class="ambient-orb orb-1"></div>
        <div class="ambient-orb orb-2"></div>
    </div>

    <nav class="navbar">
        <div class="nav-left">
            <a href="/dashboard" class="nav-logo">
                <div class="logo-icon-wrapper">
                    <svg viewBox="0 0 48 48" fill="none" width="24" height="24">
                        <rect x="4" y="8" width="40" height="32" rx="6" stroke="currentColor" stroke-width="2.5"/>
                        <polygon points="20,16 34,24 20,32" fill="currentColor"/>
                    </svg>
                </div>
                <span>Video<em>Host</em></span>
            </a>
        </div>
        <div class="nav-right">
            <a href="/dashboard" class="btn btn-ghost">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                    <line x1="19" y1="12" x2="5" y2="12"/>
                    <polyline points="12 19 5 12 12 5"/>
                </svg>
                <span>Back</span>
            </a>
            <div class="user-badge ${isAdmin ? 'badge-admin' : 'badge-viewer'}">
                <div class="badge-avatar">${isAdmin ? 'M' : 'H'}</div>
                <span>${displayName}</span>
            </div>
        </div>
    </nav>

    <main class="main-content watch-page">
        <div class="player-container">
            <video id="player" playsinline controls preload="metadata">
                <source src="${streamUrl}">
            </video>
        </div>

        <div class="video-info-section">
            <div class="video-info-header">
                <div>
                    <h1 class="video-title">${h(video.title)}</h1>
                    <div class="video-meta">
                        <span class="meta-item">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14">
                                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                                <line x1="16" y1="2" x2="16" y2="6"/>
                                <line x1="8" y1="2" x2="8" y2="6"/>
                                <line x1="3" y1="10" x2="21" y2="10"/>
                            </svg>
                            ${h(formatDate(video.uploaded_at, false))}
                        </span>
                        ${video.size ? '<span class="meta-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>' + h((video.size / (1024 * 1024)).toFixed(1)) + ' MB</span>' : ''}
                    </div>
                </div>
                ${deleteForm}
            </div>
        </div>

        <div class="comments-section">
            <h2 class="comments-title">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                </svg>
                Comments (${comments.length})
            </h2>

            <form action="/comment/${videoId}" method="POST" class="comment-form">
                <input type="hidden" name="_csrf" value="${h(csrfToken)}">
                <div class="comment-input-wrapper">
                    <div class="comment-avatar ${isAdmin ? 'avatar-admin' : 'avatar-viewer'}">${isAdmin ? 'M' : 'H'}</div>
                    <div class="comment-input-group">
                        <textarea name="text" placeholder="Write a comment..." rows="2" required maxlength="2000" class="comment-input"></textarea>
                        <button type="submit" class="btn btn-primary btn-comment">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                                <line x1="22" y1="2" x2="11" y2="13"/>
                                <polygon points="22 2 15 22 11 13 2 9 22 2"/>
                            </svg>
                            <span>Send</span>
                        </button>
                    </div>
                </div>
            </form>

            <div class="comments-list">
                ${commentsHtml}
            </div>
        </div>
    </main>

    <nav class="mobile-bottom-bar">
        <a href="/dashboard" class="bottom-nav-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22">
                <rect x="3" y="3" width="7" height="7" rx="1.5"/>
                <rect x="14" y="3" width="7" height="7" rx="1.5"/>
                <rect x="14" y="14" width="7" height="7" rx="1.5"/>
                <rect x="3" y="14" width="7" height="7" rx="1.5"/>
            </svg>
            <span>Library</span>
        </a>
        ${isAdmin ? `
        <a href="/upload" class="bottom-nav-item bottom-nav-upload">
            <div class="upload-fab">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="22" height="22">
                    <line x1="12" y1="5" x2="12" y2="19"/>
                    <line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
            </div>
            <span>Upload</span>
        </a>
        ` : ''}
        <form action="/logout" method="POST" class="bottom-nav-form">
            <input type="hidden" name="_csrf" value="${h(csrfToken)}">
            <button type="submit" class="bottom-nav-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                    <polyline points="16 17 21 12 16 7"/>
                    <line x1="21" y1="12" x2="9" y2="12"/>
                </svg>
                <span>Logout</span>
            </button>
        </form>
    </nav>
</div>
` }) %>
