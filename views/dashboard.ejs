<%
const h = escapeHtml;
const isAdmin = user === 'muaj';
const displayName = isAdmin ? 'Muaj' : 'Hajera';
const roleName = isAdmin ? 'Admin' : 'Viewer';
const videoCountText = videos.length > 0 ? videos.length + ' videos' : 'No videos yet';

function formatDate(value) {
    if (!value) return '';
    return new Date(value).toLocaleDateString('bn-BD', {
        day: 'numeric',
        month: 'short',
        year: 'numeric'
    });
}

function formatSize(value) {
    if (!value) return 'Video';
    return (value / (1024 * 1024)).toFixed(1) + ' MB';
}

const videoGrid = videos.length === 0
    ? `<div class="empty-state">
        <div class="empty-icon">
            <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.5" width="80" height="80">
                <rect x="8" y="14" width="48" height="36" rx="4"/>
                <polygon points="28,24 42,32 28,40"/>
            </svg>
        </div>
        <h2>No videos in library</h2>
        <p>${isAdmin ? 'Click Upload above to add your first private video.' : 'Muaj has not uploaded any videos yet.'}</p>
       </div>`
    : `<div class="video-grid" id="videoGrid">${videos.map((v) => {
        const watchUrl = '/watch/' + encodeURIComponent(v.id);
        return `<a href="${watchUrl}" class="video-card" data-title="${h(v.title.toLowerCase())}">
            <div class="card-thumbnail">
                <div class="card-badge">HD</div>
                <div class="play-overlay">
                    <svg viewBox="0 0 24 24" fill="currentColor" width="28" height="28">
                        <polygon points="6,4 20,12 6,20"/>
                    </svg>
                </div>
                <div class="card-duration">${h(formatSize(v.size))}</div>
            </div>
            <div class="card-info">
                <h3 class="card-title">${h(v.title)}</h3>
                <div class="card-meta">
                    <span class="meta-date">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="13" height="13"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                        ${h(formatDate(v.uploaded_at))}
                    </span>
                </div>
            </div>
        </a>`;
    }).join('')}</div>`;
%>
<%- include('layout', { pageTitle: 'Dashboard', body: `
<div class="app-container">
    <div class="ambient-background">
        <div class="ambient-orb orb-1"></div>
        <div class="ambient-orb orb-2"></div>
    </div>

    <nav class="navbar">
        <div class="nav-left">
            <a href="/dashboard" class="nav-logo">
                <div class="logo-icon-wrapper">
                    <svg viewBox="0 0 48 48" fill="none" width="24" height="24">
                        <rect x="4" y="8" width="40" height="32" rx="6" stroke="currentColor" stroke-width="2.5"/>
                        <polygon points="20,16 34,24 20,32" fill="currentColor"/>
                    </svg>
                </div>
                <span>Video<em>Host</em></span>
            </a>
        </div>
        <div class="nav-right">
            <button type="button" class="btn btn-ghost btn-icon" id="themeSwitcherNavBtn" title="Change Theme">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                    <circle cx="12" cy="12" r="10"/>
                    <path d="M12 2a10 10 0 0 0 0 20z" fill="currentColor" opacity="0.4"/>
                </svg>
            </button>
