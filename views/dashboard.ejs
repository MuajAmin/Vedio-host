<%
const h = escapeHtml;
const isAdmin = user === 'muaj';
const displayName = isAdmin ? 'Muaj' : 'Hajera';
const roleName = isAdmin ? 'Admin' : 'Viewer';
const videoCountText = videos.length > 0 ? videos.length + ' videos' : 'No videos yet';

function formatDate(value) {
    if (!value) return '';
    return new Date(value).toLocaleDateString('bn-BD', {
        day: 'numeric',
        month: 'short',
        year: 'numeric'
    });
}

function formatSize(value) {
    if (!value) return 'Video';
    return (value / (1024 * 1024)).toFixed(1) + ' MB';
}

const videoGrid = videos.length === 0
    ? `<div class="empty-state"><div class="empty-icon"><svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.5" width="80" height="80"><rect x="8" y="14" width="48" height="36" rx="4"/><polygon points="28,24 42,32 28,40"/></svg></div><h2>No videos yet</h2><p>${isAdmin ? 'Use Upload to add a new video.' : 'Muaj has not uploaded any videos yet.'}</p></div>`
    : `<div class="video-grid">${videos.map((v) => {
        const watchUrl = '/watch/' + encodeURIComponent(v.id);
        return `<a href="${watchUrl}" class="video-card"><div class="card-thumbnail"><div class="play-overlay"><svg viewBox="0 0 24 24" fill="currentColor" width="48" height="48"><polygon points="5,3 19,12 5,21"/></svg></div><div class="card-duration">${h(formatSize(v.size))}</div></div><div class="card-info"><h3 class="card-title">${h(v.title)}</h3><div class="card-meta"><span>${h(formatDate(v.uploaded_at))}</span></div></div></a>`;
    }).join('')}</div>`;
%>
<%- include('layout', { pageTitle: 'Dashboard', body: `
<div class="app-container">
    <nav class="navbar">
        <div class="nav-left">
            <a href="/dashboard" class="nav-logo">
                <svg viewBox="0 0 48 48" fill="none" width="28" height="28">
                    <rect x="4" y="8" width="40" height="32" rx="4" stroke="currentColor" stroke-width="2.5"/>
                    <polygon points="20,16 34,24 20,32" fill="currentColor"/>
                </svg>
                <span>Video<em>Host</em></span>
            </a>
        </div>
        <div class="nav-right">
            <div class="user-badge ${isAdmin ? 'badge-admin' : 'badge-viewer'}">
                <div class="badge-avatar">${isAdmin ? 'M' : 'H'}</div>
                <span>${displayName}</span>
                <span class="badge-role">${roleName}</span>
            </div>
            ${isAdmin ? '<a href="/upload" class="btn btn-primary btn-upload"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg><span>Upload</span></a>' : ''}
            <form action="/logout" method="POST" class="nav-form">
                <input type="hidden" name="_csrf" value="${h(csrfToken)}">
                <button type="submit" class="btn btn-ghost" title="Logout">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                        <polyline points="16 17 21 12 16 7"/>
                        <line x1="21" y1="12" x2="9" y2="12"/>
                    </svg>
                </button>
            </form>
        </div>
    </nav>

    <main class="main-content">
        <div class="dashboard-header">
            <h1>Video Gallery</h1>
            <p class="subtitle">${h(videoCountText)}</p>
        </div>

        ${videoGrid}
    </main>
</div>
` }) %>
