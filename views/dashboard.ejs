<%
const h = escapeHtml;
const isAdmin = user === 'muaj';
const isHajera = user === 'hajera';
const displayName = isAdmin ? 'Muaj' : 'Hajera';
const roleName = isAdmin ? 'Admin' : 'Viewer';
const videoCountText = videos.length > 0 ? videos.length + ' videos' : 'No videos yet';
const avatars = (typeof userAvatars !== 'undefined' && userAvatars) ? userAvatars : ((typeof locals !== 'undefined' && locals.userAvatars) ? locals.userAvatars : {});
function renderAvatar(uname, extraCls = '') {
    const avatar = avatars[uname];
    const cleanCls = h(extraCls || '');
    const cleanUname = h(uname || '');
    if (avatar) {
        return `<img src="/avatars/${h(avatar)}" alt="${cleanUname}" class="avatar-img ${cleanCls}" loading="lazy" />`;
    }
    const letter = (uname === 'muaj') ? 'M' : 'H';
    const roleClass = (uname === 'muaj') ? 'avatar-admin' : 'avatar-viewer';
    return `<div class="avatar-letter ${roleClass} ${cleanCls}">${letter}</div>`;
}

function formatDate(value) {
    if (!value) return '';
    return new Date(value).toLocaleDateString('bn-BD', {
        day: 'numeric',
        month: 'short',
        year: 'numeric'
    });
}

function formatSize(value) {
    if (!value) return 'Video';
    return (value / (1024 * 1024)).toFixed(1) + ' MB';
}

function progressPercent(video) {
    const position = Number(video.position_seconds || 0);
    const duration = Number(video.duration_seconds || 0);
    if (!position || !duration || position >= duration - 10) return 0;
    return Math.max(3, Math.min(96, Math.round((position / duration) * 100)));
}

function formatWatchPosition(video) {
    const position = Number(video.position_seconds || 0);
    if (!position) return '';
    const mins = Math.floor(position / 60);
    const secs = Math.floor(position % 60);
    return mins + ':' + (secs < 10 ? '0' : '') + secs;
}

function isNewVideo(v) {
    if (!v || !v.uploaded_at) return false;
    const uploadTime = new Date(v.uploaded_at).getTime();
    if (isNaN(uploadTime)) return false;
    const now = Date.now();
    // Video is NEW if uploaded within the last 48 hours OR if unwatched & uploaded in last 7 days
    const isWithin48h = (now - uploadTime) < (48 * 60 * 60 * 1000);
    const isUnwatchedRecent = !v.position_seconds && (now - uploadTime) < (7 * 24 * 60 * 60 * 1000);
    return isWithin48h || isUnwatchedRecent;
}

function renderVideoCard(v, extraClass) {
    const watchUrl = '/watch/' + encodeURIComponent(v.id);
    const thumbImg = v.thumbnail
        ? `<img src="/thumbnails/${h(v.thumbnail)}" alt="${h(v.title)}" class="thumb-img" loading="lazy" />`
        : '';
    const progress = progressPercent(v);
    const progressHtml = progress
        ? `<div class="card-watch-progress" title="Continue from ${h(formatWatchPosition(v))}"><span style="width:${h(progress)}%"></span></div>`
        : '';
    const isNew = isNewVideo(v);
    const uploader = v.uploaded_by || 'muaj';
    const uploaderName = uploader === 'hajera' ? 'Hajera' : (uploader === 'muaj' ? 'Muaj' : uploader);

    const badgeMarkup = isNew
        ? `<div class="card-badge badge-new"><span class="badge-pulse-dot"></span><span>NEW</span></div>`
        : (progress ? `<div class="card-badge badge-resume"><span>RESUME</span></div>` : '');

    return `<a href="${watchUrl}" class="video-card ${extraClass || ''}" data-title="${h(String(v.title || '').toLowerCase())}">
        <div class="card-thumbnail">
            ${thumbImg}
            <div class="thumb-placeholder ${v.thumbnail ? 'has-thumb' : ''}">
                <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" width="48" height="48">
                    <rect x="6" y="10" width="36" height="28" rx="4"/>
                    <polygon points="20,18 32,24 20,30" fill="currentColor"/>
                </svg>
            </div>
            ${badgeMarkup}
            <div class="play-overlay">
                <svg viewBox="0 0 24 24" fill="currentColor" width="28" height="28">
                    <polygon points="6,4 20,12 6,20"/>
                </svg>
            </div>
            <div class="card-duration">${v.duration ? h(v.duration) : h(formatSize(v.size))}</div>
            ${progressHtml}
        </div>
        <div class="card-info">
            <div class="card-avatar" title="Uploaded by ${h(uploaderName)}">
                ${renderAvatar(uploader, 'card-avatar-img')}
            </div>
            <div class="card-details">
                <h3 class="card-title">${h(v.title)}</h3>
                <div class="card-meta">
                    <span class="meta-author" title="Uploaded by ${h(uploaderName)}">${h(uploaderName)}</span>
                    <span class="meta-dot">•</span>
                    <span class="meta-size">${h(formatSize(v.size))}</span>
                    <span class="meta-dot">•</span>
                    <span class="meta-date">${h(formatDate(v.uploaded_at))}</span>
                </div>
            </div>
        </div>
    </a>`;
}

const continueItems = Array.isArray(continueVideos) ? continueVideos : [];
const continueSection = continueItems.length === 0
    ? ''
    : `<section class="continue-section">
        <div class="section-heading-row">
            <div>
                <span class="header-pill">Continue Watching</span>
                <h2>Pick up where you left off</h2>
            </div>
        </div>
        <div class="continue-rail">${continueItems.map(v => renderVideoCard(v, 'continue-card')).join('')}</div>
    </section>`;

const videoGrid = videos.length === 0
    ? `<div class="empty-state">
        <div class="empty-icon">
            <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.5" width="80" height="80">
                <rect x="8" y="14" width="48" height="36" rx="4"/>
                <polygon points="28,24 42,32 28,40"/>
            </svg>
        </div>
        <h2>No videos in library</h2>
        <p>Click Upload above to add your first private video.</p>
       </div>`
    : `<div class="video-grid" id="videoGrid">${videos.map(v => renderVideoCard(v)).join('')}</div>`;
%>
